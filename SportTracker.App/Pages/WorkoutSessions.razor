@page "/workoutsessions"
@using SportTracker.Core.Models
@inject HttpClient Http

<main class="v4-workouts">
    <header class="v4-workouts__heading">
        <h1>Tes séances</h1>
        <p>Ton journal de musculation</p>
    </header>
    <V4ActivityTabs />
    <V4Button Href="/workoutsessions/new">+ Nouvelle séance</V4Button>

    @if (isLoading)
    {
        <V4Loading />
    }
    else if (errorMessage is not null)
    {
        <V4State Title="Impossible de charger les séances" Message="@errorMessage" IsError="true" OnRetry="LoadSessionsAsync" />
    }
    else if (sessions is not null && !sessions.Any())
    {
        <V4State Title="Première séance" Message="Commence ton journal de musculation avec une première séance.">
            <V4Button Href="/workoutsessions/new">Créer ma séance</V4Button>
        </V4State>
    }
    else if (sessions is not null)
    {
        <section class="v4-session-list" aria-label="Historique des séances">
            @foreach (var session in sessions.OrderByDescending(s => s.Date))
            {
                var exercises = session.WorkoutExercises?.Count ?? 0;
                <a class="v4-session-row" href="/workoutsessions/@session.Id">
                    <span class="v4-session-row__icon" aria-hidden="true">♟</span>
                    <span class="v4-session-row__content">
                        <strong>@session.Name</strong>
                        <small>@session.Date.ToString("dd MMM.") · @FormatMinutes(session.Duration) · @exercises exercice@(exercises > 1 ? "s" : "")</small>
                    </span>
                    <span class="v4-session-row__chevron" aria-hidden="true">›</span>
                </a>
            }
        </section>
    }
</main>

@code {
    private List<WorkoutSession>? sessions;
    private bool isLoading = true;
    private string? errorMessage;

    protected override Task OnInitializedAsync() => LoadSessionsAsync();

    private async Task LoadSessionsAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            sessions = await Http.GetFromJsonAsync<List<WorkoutSession>>("api/workoutsessions");
            sessions ??= new();
        }
        catch (Exception)
        {
            errorMessage = "Vérifie ta connexion, puis réessaie.";
        }
        finally { isLoading = false; }
    }

    private static string FormatMinutes(TimeSpan duration)
        => duration.TotalMinutes > 0 ? $"{(int)duration.TotalMinutes} min" : "durée non renseignée";
}
