@page "/history"
@using SportTracker.Core.Models
@using SportTracker.Core.Enums
@inject HttpClient Http

<div class="history-page">
    <V4Header Title="Ton historique" Subtitle="Toutes tes séances, au même endroit" />

    <div class="hi-seg" role="tablist" aria-label="Filtrer l'historique">
        @foreach (var f in filters)
        {
            var filter = f;
            <button role="tab" aria-selected="@(activeFilter == filter)" class="hi-seg__btn @(activeFilter == filter ? "hi-seg__btn--active" : "")" @onclick="() => activeFilter = filter">
                @filter
            </button>
        }
    </div>

    @if (errorMessage is not null)
    {
        <V4State Title="Impossible de charger l'historique" Message="@errorMessage" IsError="true" OnRetry="LoadAsync" />
    }
    else if (allItems == null)
    {
        <V4Loading />
    }
    else if (!FilteredItems.Any())
    {
        <V4State Title="Aucune séance enregistrée" Message="Tes séances apparaîtront ici une fois enregistrées." />
    }
    else
    {
        @foreach (var group in GroupedItems)
        {
            <div class="hi-group">
                <p class="hi-group__label">@group.Key</p>
                @foreach (var item in group)
                {
                    <a href="@item.DetailUrl" class="hi-item-link">
                        <V4Card>
                            <div class="hi-item">
                                <div class="hi-item__icon" style="background: @item.IconBg">
                                    @((MarkupString)item.IconSvg)
                                </div>
                                <div class="hi-item__info">
                                    <strong>@item.Name</strong>
                                    <span>@item.Meta</span>
                                </div>
                                <svg class="hi-item__chevron" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="9 18 15 12 9 6"/>
                                </svg>
                            </div>
                        </V4Card>
                    </a>
                }
            </div>
        }
    }

    <div class="hi-fab-row">
        <V4Button Href="/workoutsessions/new">+ Muscu</V4Button>
        <V4Button Href="/cardiosessions/new" Secondary="true">+ Cardio</V4Button>
    </div>
</div>

@code {
    private record HistoryItem(
        string Name, DateTime Date, string Meta,
        string DetailUrl, string IconBg, string IconSvg, string Kind);

    private List<HistoryItem>? allItems;
    private string? errorMessage;
    private string activeFilter = "Tous";

    private static readonly string[] filters = ["Tous", "Muscu", "Cardio"];

    private IEnumerable<HistoryItem> FilteredItems => activeFilter switch
    {
        "Muscu"  => allItems?.Where(i => i.Kind == "workout") ?? [],
        "Cardio" => allItems?.Where(i => i.Kind == "cardio")  ?? [],
        _        => allItems ?? []
    };

    private IEnumerable<IGrouping<string, HistoryItem>> GroupedItems =>
        FilteredItems
            .OrderByDescending(i => i.Date)
            .GroupBy(i => GetPeriodLabel(i.Date));

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            errorMessage = null;
            allItems = null;

            var workoutsTask = Http.GetFromJsonAsync<List<WorkoutSession>>("api/workoutsessions");
            var cardioTask   = Http.GetFromJsonAsync<List<CardioSession>>("api/cardiosessions");
            await Task.WhenAll(workoutsTask, cardioTask);

            var items = new List<HistoryItem>();

            foreach (var s in workoutsTask.Result ?? [])
            {
                var duration = $"{(int)s.Duration.TotalMinutes} min";
                var exCount  = s.WorkoutExercises?.Count ?? 0;
                items.Add(new HistoryItem(
                    s.Name, s.Date,
                    $"{s.Date:dd MMM} • {duration} • {exCount} exercice{(exCount > 1 ? "s" : "")}",
                    $"/workoutsessions/{s.Id}",
                    "#D4F53C",
                    DumbbellSvg("#082D45"),
                    "workout"));
            }

            foreach (var s in cardioTask.Result ?? [])
            {
                var duration = $"{(int)s.Duration.TotalMinutes} min";
                var (bg, svg) = CardioIcon(s.Type);
                var distanceStr = s.Distance > 0 ? $" • {s.Distance:F1} km" : "";
                items.Add(new HistoryItem(
                    s.Name, s.Date,
                    $"{s.Date:dd MMM} • {duration}{distanceStr}",
                    $"/cardiosessions/{s.Id}",
                    bg,
                    svg,
                    "cardio"));
            }

            allItems = items;
        }
        catch
        {
            errorMessage = "Impossible de récupérer tes séances.";
            allItems = null;
        }
    }

    private static string GetPeriodLabel(DateTime date)
    {
        var today    = DateTime.Today;
        var monday   = today.AddDays(-(((int)today.DayOfWeek + 6) % 7));
        var lastMon  = monday.AddDays(-7);
        return date >= monday   ? "Cette semaine"
             : date >= lastMon  ? "Semaine dernière"
             : "Plus tôt";
    }

    private static (string bg, string svg) CardioIcon(CardioType type) => type switch
    {
        CardioType.Run  => ("#DDF6F4", ActivitySvg("#082D45")),
        CardioType.Bike => ("#DDF6F4", ActivitySvg("#082D45")),
        CardioType.Swim => ("#082D45", ActivitySvg("#D4F53C")),
        CardioType.Walk => ("#DDF6F4", WindSvg("#082D45")),
        _               => ("#DDF6F4", ActivitySvg("#082D45")),
    };

    private static string DumbbellSvg(string color) =>
        $"""<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="{color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 5v14"/><path d="M18 5v14"/><path d="M2 9h4"/><path d="M18 9h4"/><path d="M2 15h4"/><path d="M18 15h4"/><line x1="6" y1="9" x2="18" y2="9"/><line x1="6" y1="15" x2="18" y2="15"/></svg>""";

    private static string ActivitySvg(string color) =>
        $"""<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="{color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>""";

    private static string WindSvg(string color) =>
        $"""<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="{color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.7 7.7a2.5 2.5 0 1 1 1.8 4.3H2"/><path d="M9.6 4.6A2 2 0 1 1 11 8H2"/><path d="M12.6 19.4A2 2 0 1 0 14 16H2"/></svg>""";
}
