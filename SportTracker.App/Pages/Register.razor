@page "/register"
@layout EmptyLayout
@attribute [AllowAnonymous]
@inject AuthService Auth
@inject NavigationManager Nav

<div class="auth-page">
    <div class="auth-brand">
        <span class="title-eyebrow">Rejoins</span>
        <h1 class="auth-title">SportTracker</h1>
    </div>

    <EditForm Model="model" OnValidSubmit="HandleRegister" class="auth-form">
        <DataAnnotationsValidator />

        @if (error is not null)
        {
            <div class="error-card">@error</div>
        }

        <div class="field-group">
            <label class="field-label">EMAIL</label>
            <InputText @bind-Value="model.Email" type="email" autocomplete="username"
                       class="field-input" placeholder="toi@exemple.fr" />
            <ValidationMessage For="() => model.Email" />
        </div>

        <div class="field-group">
            <label class="field-label">MOT DE PASSE</label>
            <InputText @bind-Value="model.Password" type="password" autocomplete="new-password"
                       class="field-input" placeholder="6 caractères minimum" />
            <ValidationMessage For="() => model.Password" />
        </div>

        <div class="form-actions">
            <button type="submit" class="submit-btn" disabled="@busy">
                @(busy ? "Création…" : "Créer mon compte")
            </button>
        </div>
    </EditForm>

    <p class="auth-switch">
        Déjà un compte ?
        <a href="/login">Se connecter</a>
    </p>
</div>

@code {
    private readonly Registration model = new();
    private bool busy;
    private string? error;

    private async Task HandleRegister()
    {
        busy = true;
        error = null;

        error = await Auth.RegisterAsync(model.Email, model.Password);

        busy = false;

        if (error is null)
            Nav.NavigateTo("/");
    }

    private sealed class Registration
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Email requis")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Email invalide")]
        public string Email { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Mot de passe requis")]
        [System.ComponentModel.DataAnnotations.MinLength(6, ErrorMessage = "6 caractères minimum")]
        public string Password { get; set; } = "";
    }
}
