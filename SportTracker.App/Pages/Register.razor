@page "/register"
@layout EmptyLayout
@attribute [AllowAnonymous]
@inject AuthService Auth
@inject NavigationManager Nav

<div class="auth-page">
    <header class="auth-heading">
        <h1>Créer ton compte</h1>
        <p>Bienvenue sur SportTracker</p>
    </header>

    <EditForm Model="model" OnValidSubmit="HandleRegister" class="auth-card">
        <DataAnnotationsValidator />

        <section class="auth-intro auth-intro--compact">
            <img src="assets/v4/021-goal.png" alt="" width="64" height="64" />
            <h2>Une place pour tous tes efforts.</h2>
            <p>Enregistre tes séances et construis tes carnets.</p>
        </section>

        @if (error is not null)
        {
            <div class="auth-error" role="alert">@error</div>
        }

        <div class="field-group">
            <label class="field-label" for="register-email">Adresse e-mail</label>
            <InputText @bind-Value="model.Email" type="email" autocomplete="username"
                       id="register-email" class="field-input" placeholder="toi@exemple.fr" />
            <ValidationMessage For="() => model.Email" />
        </div>

        <div class="field-group">
            <label class="field-label" for="register-password">Mot de passe</label>
            <InputText @bind-Value="model.Password" type="password" autocomplete="new-password"
                       id="register-password" class="field-input" placeholder="6 caractères minimum" />
            <ValidationMessage For="() => model.Password" />
        </div>

        <div class="form-actions">
            <button type="submit" class="auth-primary" disabled="@busy">
                @(busy ? "Création…" : "Créer mon compte")
            </button>
        </div>

        <p class="auth-switch">Tu as déjà un compte ?</p>
        <a class="auth-secondary" href="/login">Se connecter</a>
    </EditForm>
</div>

@code {
    private readonly Registration model = new();
    private bool busy;
    private string? error;

    private async Task HandleRegister()
    {
        busy = true;
        error = null;

        error = await Auth.RegisterAsync(model.Email, model.Password);

        busy = false;

        if (error is null)
            Nav.NavigateTo("/");
    }

    private sealed class Registration
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Email requis")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Email invalide")]
        public string Email { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Mot de passe requis")]
        [System.ComponentModel.DataAnnotations.MinLength(6, ErrorMessage = "6 caractères minimum")]
        public string Password { get; set; } = "";
    }
}
