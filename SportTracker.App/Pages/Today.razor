@page "/"
@using SportTracker.Core.Models
@using SportTracker.Core.Enums
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http

<div class="today-page">

    <header class="today-head">
        <p class="today-eyebrow">@headerDate</p>
        <h1 class="today-title">@greeting</h1>
    </header>

    @if (loading)
    {
        <div class="st-skel-block">
            <div class="st-skeleton st-skel-tall"></div>
            <div class="st-skel-row">
                <div class="st-skeleton st-skel-sm" style="flex:1"></div>
                <div class="st-skeleton st-skel-sm" style="flex:1"></div>
                <div class="st-skeleton st-skel-sm" style="flex:1"></div>
            </div>
            <div class="st-skeleton st-skel-med"></div>
        </div>
    }
    else
    {
        @* ── Hero : séance du jour ── *@
        @if (todayWorkout != null)
        {
            <section class="today-hero glass-hero">
                <div class="today-hero__glow"></div>
                <div class="today-hero__head">
                    <span class="today-hero__eyebrow">Séance du jour</span>
                    <h2 class="today-hero__name">@todayWorkout.Name</h2>
                </div>
                <div class="today-hero__pills">
                    <span class="hero-pill">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 5v14M18 5v14M2 9h4M18 9h4M2 15h4M18 15h4"/><line x1="6" y1="12" x2="18" y2="12"/></svg>
                        @(todayWorkout.WorkoutExercises?.Count ?? 0) exercices
                    </span>
                    @if (todayWorkout.Duration.TotalMinutes >= 1)
                    {
                        <span class="hero-pill">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 16 14"/></svg>
                            @((int)todayWorkout.Duration.TotalMinutes) min
                        </span>
                    }
                </div>
                <a href="/workoutsessions/@todayWorkout.Id" class="today-hero__cta">Commencer la séance</a>
            </section>
        }
        else if (todayCardio != null)
        {
            <section class="today-hero glass-hero">
                <div class="today-hero__glow"></div>
                <div class="today-hero__head">
                    <span class="today-hero__eyebrow">Cardio du jour</span>
                    <h2 class="today-hero__name">@todayCardio.Name</h2>
                </div>
                <div class="today-hero__pills">
                    <span class="hero-pill">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 4l-4 16"/><circle cx="18" cy="6" r="2"/><path d="M4 9l4-1 3 3 3 1"/></svg>
                        @todayCardio.Distance.ToString("0.#", frFR) km
                    </span>
                    @if (todayCardio.Duration.TotalMinutes >= 1)
                    {
                        <span class="hero-pill">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 16 14"/></svg>
                            @((int)todayCardio.Duration.TotalMinutes) min
                        </span>
                    }
                </div>
                <a href="/cardiosessions/@todayCardio.Id" class="today-hero__cta">Voir la séance</a>
            </section>
        }
        else
        {
            <section class="today-hero glass-hero today-hero--empty">
                <div class="today-hero__glow"></div>
                <h2 class="today-hero__name">Aucune séance aujourd'hui</h2>
                <p class="today-hero__sub">C'est le bon moment pour s'y mettre.</p>
                <div class="today-hero__actions">
                    <a href="/workoutsessions/new" class="hero-action hero-action--dark">+ Muscu</a>
                    <a href="/cardiosessions/new" class="hero-action hero-action--outline">+ Cardio</a>
                </div>
            </section>
        }

        @* ── Stats de la semaine ── *@
        <section class="today-week">
            <h3 class="today-section-label">Cette semaine</h3>
            <div class="week-grid">
                <div class="week-stat">
                    <span class="week-stat__label">Séances</span>
                    <span class="week-stat__val">@weekCount</span>
                </div>
                <div class="week-stat">
                    <span class="week-stat__label">Volume</span>
                    <span class="week-stat__val">@weekVolumeValue<span class="week-stat__unit">@weekVolumeUnit</span></span>
                </div>
                <div class="week-stat">
                    <span class="week-stat__label">Temps</span>
                    <span class="week-stat__val">@weekTimeText</span>
                </div>
            </div>
        </section>

        @* ── Reprendre ── *@
        @if (suggestedWorkout != null)
        {
            <a href="/workoutsessions/@suggestedWorkout.Id" class="today-resume">
                <div class="today-resume__left">
                    <div class="today-resume__icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zM10 8l6 4-6 4z"/></svg>
                    </div>
                    <div class="today-resume__text">
                        <span class="today-resume__eyebrow">Reprendre</span>
                        <h4 class="today-resume__name">@suggestedWorkout.Name</h4>
                        <span class="today-resume__sub">@Capitalize(suggestedWorkout.Date.ToString("ddd dd MMM", frFR))</span>
                    </div>
                </div>
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </a>
        }
    }

</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private static readonly CultureInfo frFR = CultureInfo.GetCultureInfo("fr-FR");

    private bool loading = true;
    private WorkoutSession? todayWorkout;
    private CardioSession? todayCardio;
    private WorkoutSession? suggestedWorkout;

    private string headerDate = "";
    private string greeting = "Bonjour";

    private int weekCount;
    private string weekVolumeValue = "0";
    private string weekVolumeUnit = "kg";
    private string weekTimeText = "0min";

    protected override async Task OnInitializedAsync()
    {
        headerDate = $"Aujourd'hui — {DateTime.Today.ToString("ddd dd MMM", frFR)}".ToUpper();
        greeting = await BuildGreetingAsync();

        var workoutsTask = Http.GetFromJsonAsync<List<WorkoutSession>>("api/workoutsessions");
        var cardioTask   = Http.GetFromJsonAsync<List<CardioSession>>("api/cardiosessions");
        await Task.WhenAll(workoutsTask, cardioTask);

        var workouts = workoutsTask.Result ?? [];
        var cardio   = cardioTask.Result ?? [];

        var today = DateTime.Today;

        todayWorkout = workouts.Where(s => s.Date.Date == today).MaxBy(s => s.Date);
        todayCardio  = cardio.Where(s => s.Date.Date == today).MaxBy(s => s.Date);

        suggestedWorkout = workouts
            .Where(s => s.Date.Date != today)
            .OrderByDescending(s => s.Date)
            .FirstOrDefault();

        // Semaine ISO (lundi → aujourd'hui)
        var startOfWeek = today.AddDays(-(((int)today.DayOfWeek + 6) % 7));
        var weekWorkouts = workouts.Where(s => s.Date.Date >= startOfWeek && s.Date.Date <= today).ToList();
        var weekCardio   = cardio.Where(s => s.Date.Date >= startOfWeek && s.Date.Date <= today).ToList();

        weekCount = weekWorkouts.Count + weekCardio.Count;

        var volumeKg = weekWorkouts
            .SelectMany(w => w.WorkoutExercises ?? new())
            .SelectMany(e => e.ExerciseSets ?? new())
            .Sum(set => set.Weight * set.Repetitions);
        FormatVolume(volumeKg);

        var totalMinutes = (int)weekWorkouts.Sum(s => s.Duration.TotalMinutes)
                         + (int)weekCardio.Sum(s => s.Duration.TotalMinutes);
        weekTimeText = FormatDurationMinutes(totalMinutes);

        loading = false;
    }

    private async Task<string> BuildGreetingAsync()
    {
        if (AuthState is null) return "Bonjour";
        try
        {
            var state = await AuthState;
            var raw = state.User.Identity?.Name;
            if (string.IsNullOrWhiteSpace(raw)) return "Bonjour";
            var at = raw.IndexOf('@');
            var name = at > 0 ? raw[..at] : raw;
            name = Capitalize(name);
            return $"Salut {name}";
        }
        catch
        {
            return "Bonjour";
        }
    }

    private void FormatVolume(double kg)
    {
        if (kg >= 1000)
        {
            weekVolumeValue = (kg / 1000).ToString("0.#", frFR);
            weekVolumeUnit = "t";
        }
        else
        {
            weekVolumeValue = kg.ToString("0", frFR);
            weekVolumeUnit = "kg";
        }
    }

    private static string FormatDurationMinutes(int minutes)
    {
        if (minutes >= 60)
        {
            var h = minutes / 60;
            var m = minutes % 60;
            return m > 0 ? $"{h}h{m:D2}" : $"{h}h";
        }
        return $"{minutes}min";
    }

    private static string Capitalize(string s)
        => string.IsNullOrEmpty(s) ? s : char.ToUpper(s[0]) + s[1..];
}
