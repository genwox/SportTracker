@page "/"
@using SportTracker.Core.Models
@using SportTracker.Core.Enums
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http

<div class="today-page">
    <V4Header Title="@greeting" Subtitle="@subtitle" />

    @if (loading)
    {
        <V4Loading />
    }
    else if (errorMessage is not null)
    {
        <V4State Title="Impossible de charger ta journée" Message="@errorMessage" IsError="true" OnRetry="LoadAsync" />
    }
    else
    {
        @if (todayWorkout != null)
        {
            <V4Card>
                <div class="t-hero">
                    <span class="t-hero__eyebrow">Ta séance du jour</span>
                    <h2 class="t-hero__name">@todayWorkout.Name</h2>
                    <span class="t-hero__meta">@(todayWorkout.WorkoutExercises?.Count ?? 0) exercice@((todayWorkout.WorkoutExercises?.Count ?? 0) > 1 ? "s" : "") • @((int)todayWorkout.Duration.TotalMinutes) min</span>
                    <V4Button Href="@($"/workoutsessions/{todayWorkout.Id}")">Commencer la séance</V4Button>
                </div>
            </V4Card>
        }
        else if (todayCardio != null)
        {
            <V4Card>
                <div class="t-hero">
                    <span class="t-hero__eyebrow">Cardio du jour</span>
                    <h2 class="t-hero__name">@todayCardio.Name</h2>
                    <span class="t-hero__meta">@todayCardio.Distance.ToString("0.#", frFR) km • @((int)todayCardio.Duration.TotalMinutes) min</span>
                    <V4Button Href="@($"/cardiosessions/{todayCardio.Id}")">Voir la séance</V4Button>
                </div>
            </V4Card>
        }
        else
        {
            <V4Card>
                <div class="t-hero t-hero--empty">
                    <div class="t-hero__icon" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/></svg>
                    </div>
                    <h2 class="t-hero__name">Aucune séance aujourd'hui</h2>
                    <p class="t-hero__sub">Enregistre ta première séance pour commencer ton suivi.</p>
                    <div class="t-hero__actions">
                        <V4Button Href="/workoutsessions/live">Démarrer une séance à vide</V4Button>
                        <V4Button Href="/workoutsessions/new" Secondary="true">Créer une séance musculation</V4Button>
                        <V4Button Href="/cardiosessions/new" Secondary="true">+ Séance cardio</V4Button>
                    </div>
                </div>
            </V4Card>
        }

        <div class="t-section-label">Cette semaine</div>
        <V4Card>
            <div class="t-week-grid">
                <div class="t-week-stat">
                    <span class="t-week-stat__val">@weekCount</span>
                    <span class="t-week-stat__label">séance@(weekCount > 1 ? "s" : "")</span>
                </div>
                <div class="t-week-stat">
                    <span class="t-week-stat__val">@weekVolumeValue<span class="t-week-stat__unit">@weekVolumeUnit</span></span>
                    <span class="t-week-stat__label">volume</span>
                </div>
                <div class="t-week-stat">
                    <span class="t-week-stat__val">@weekTimeText</span>
                    <span class="t-week-stat__label">temps</span>
                </div>
            </div>
        </V4Card>

        @if (weekCount > 0)
        {
            <div class="t-section-label">Tes séances</div>
            <V4Card>
                <div class="t-bars">
                    @{ var maxDay = weekData.Max(d => d.count) is int m && m > 0 ? m : 1; }
                    @foreach (var day in weekData)
                    {
                        var heightPct = day.count == 0 ? 0 : Math.Max(10, (double)day.count / maxDay * 100);
                        <div class="t-bar-col">
                            <div class="t-bar-slot">
                                @if (day.count > 0)
                                {
                                    <div class="t-bar-fill @(day.isToday ? "t-bar-fill--active" : "")" style="height: @(heightPct)%"></div>
                                }
                            </div>
                            <span class="t-bar-label @(day.isToday ? "t-bar-label--active" : "")">@day.label</span>
                        </div>
                    }
                </div>
            </V4Card>
        }
        else
        {
            <a href="/programs" class="t-carnet-link">
                <V4Card>
                    <div class="t-carnet">
                        <div class="t-carnet__icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                        </div>
                        <div class="t-carnet__text">
                            <strong>Préparer un carnet</strong>
                            <span>Organise tes prochains entraînements.</span>
                        </div>
                    </div>
                </V4Card>
            </a>
        }

        @if (suggestedWorkout != null)
        {
            <a href="/workoutsessions/@suggestedWorkout.Id" class="t-resume-link">
                <V4Card>
                    <div class="t-resume">
                        <div class="t-resume__text">
                            <span class="t-resume__eyebrow">Reprendre</span>
                            <strong class="t-resume__name">@suggestedWorkout.Name</strong>
                            <span class="t-resume__sub">Dernière séance · @Capitalize(suggestedWorkout.Date.ToString("d MMMM", frFR))</span>
                        </div>
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                    </div>
                </V4Card>
            </a>
        }
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private static readonly CultureInfo frFR = CultureInfo.GetCultureInfo("fr-FR");

    private bool loading = true;
    private string? errorMessage;
    private WorkoutSession? todayWorkout;
    private CardioSession? todayCardio;
    private WorkoutSession? suggestedWorkout;

    private string greeting = "Bonjour";
    private string subtitle = "";

    private int weekCount;
    private string weekVolumeValue = "0";
    private string weekVolumeUnit = "kg";
    private string weekTimeText = "0min";
    private List<(string label, int count, bool isToday)> weekData = [];

    protected override async Task OnInitializedAsync()
    {
        greeting = await BuildGreetingAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        errorMessage = null;

        List<WorkoutSession> workouts;
        List<CardioSession> cardio;
        try
        {
            var workoutsTask = Http.GetFromJsonAsync<List<WorkoutSession>>("api/workoutsessions");
            var cardioTask   = Http.GetFromJsonAsync<List<CardioSession>>("api/cardiosessions");
            await Task.WhenAll(workoutsTask, cardioTask);
            workouts = workoutsTask.Result ?? [];
            cardio   = cardioTask.Result ?? [];
        }
        catch
        {
            errorMessage = "Impossible de récupérer tes séances. Vérifie ta connexion, puis réessaie.";
            loading = false;
            return;
        }

        var today = DateTime.Today;

        todayWorkout = workouts.Where(s => s.Date.Date == today).MaxBy(s => s.Date);
        todayCardio  = cardio.Where(s => s.Date.Date == today).MaxBy(s => s.Date);

        subtitle = (todayWorkout == null && todayCardio == null)
            ? "Une nouvelle journée commence."
            : Capitalize(today.ToString("dddd d MMMM", frFR));

        suggestedWorkout = workouts
            .Where(s => s.Date.Date != today)
            .OrderByDescending(s => s.Date)
            .FirstOrDefault();

        // Semaine ISO (lundi → aujourd'hui)
        var startOfWeek = today.AddDays(-(((int)today.DayOfWeek + 6) % 7));
        var weekWorkouts = workouts.Where(s => s.Date.Date >= startOfWeek && s.Date.Date <= today).ToList();
        var weekCardio   = cardio.Where(s => s.Date.Date >= startOfWeek && s.Date.Date <= today).ToList();

        weekCount = weekWorkouts.Count + weekCardio.Count;

        var volumeKg = weekWorkouts
            .SelectMany(w => w.WorkoutExercises ?? new())
            .SelectMany(e => e.ExerciseSets ?? new())
            .Sum(set => set.Weight * set.Repetitions);
        FormatVolume(volumeKg);

        var totalMinutes = (int)weekWorkouts.Sum(s => s.Duration.TotalMinutes)
                         + (int)weekCardio.Sum(s => s.Duration.TotalMinutes);
        weekTimeText = FormatDurationMinutes(totalMinutes);

        weekData = Enumerable.Range(0, 7).Select(i =>
        {
            var day = startOfWeek.AddDays(i);
            var count = workouts.Count(s => s.Date.Date == day) + cardio.Count(s => s.Date.Date == day);
            var labels = new[] { "L", "M", "M", "J", "V", "S", "D" };
            return (labels[i], count, day == today);
        }).ToList();

        loading = false;
    }

    private async Task<string> BuildGreetingAsync()
    {
        if (AuthState is null) return "Bonjour";
        try
        {
            var state = await AuthState;
            var raw = state.User.Identity?.Name;
            if (string.IsNullOrWhiteSpace(raw)) return "Bonjour";
            var at = raw.IndexOf('@');
            var name = at > 0 ? raw[..at] : raw;
            name = Capitalize(name);
            return $"Bonjour {name}";
        }
        catch
        {
            return "Bonjour";
        }
    }

    private void FormatVolume(double kg)
    {
        if (kg >= 1000)
        {
            weekVolumeValue = (kg / 1000).ToString("0.#", frFR);
            weekVolumeUnit = "t";
        }
        else
        {
            weekVolumeValue = kg.ToString("0", frFR);
            weekVolumeUnit = "kg";
        }
    }

    private static string FormatDurationMinutes(int minutes)
    {
        if (minutes >= 60)
        {
            var h = minutes / 60;
            var m = minutes % 60;
            return m > 0 ? $"{h}h{m:D2}" : $"{h}h";
        }
        return $"{minutes}min";
    }

    private static string Capitalize(string s)
        => string.IsNullOrEmpty(s) ? s : char.ToUpper(s[0]) + s[1..];
}
