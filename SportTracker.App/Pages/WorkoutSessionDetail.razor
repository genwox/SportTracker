@page "/workoutsessions/{Id:int}"
@using SportTracker.Core.Models
@using System.Globalization
@inject HttpClient Http
@inject NavigationManager Nav

<div class="detail-page">

@if (session is null && !notFound)
{
    <div class="st-skel-block" style="padding-top:52px">
        <div class="st-skel-row" style="align-items:center; gap:12px; margin-bottom:8px;">
            <div class="st-skeleton" style="width:38px;height:38px;border-radius:50%;flex-shrink:0"></div>
            <div class="st-skeleton st-skel-line" style="width:55%; height:28px"></div>
        </div>
        <div class="st-skeleton" style="height:90px"></div>
        <div class="st-skeleton st-skel-tall"></div>
    </div>
}
else if (notFound)
{
    <div class="not-found">
        <p>Séance introuvable.</p>
        <a href="/workoutsessions" class="back-btn">← Retour</a>
    </div>
}
else
{
    <div class="detail-header">
        <a href="/workoutsessions" class="back-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"/>
            </svg>
        </a>
        <span class="wsd-date">@Capitalize(session!.Date.ToString("ddd dd MMM yyyy", frFR))</span>
    </div>

    <section class="wsd-hero glass-hero">
        <h1 class="wsd-name">@session.Name</h1>
        <div class="wsd-pills">
            <span class="wsd-pill">@FormatDuration(session.Duration)</span>
            <span class="wsd-pill">@FormatVolume(TotalVolume) volume</span>
            <span class="wsd-pill">@(session.WorkoutExercises?.Count ?? 0) exercices</span>
        </div>
    </section>

    @if (session.WorkoutExercises is null || !session.WorkoutExercises.Any())
    {
        <p class="empty-text">Aucun exercice enregistré.</p>
    }
    else
    {
        <div class="exercises-list">
            @foreach (var we in session.WorkoutExercises)
            {
                <div class="exercise-card">
                    <p class="exercise-name">@(we.Exercise?.Name ?? $"Exercice #{we.ExerciseId}")</p>

                    @if (we.ExerciseSets is null || !we.ExerciseSets.Any())
                    {
                        <p class="no-sets">Aucune série.</p>
                    }
                    else
                    {
                        <div class="set-pills">
                            @foreach (var set in we.ExerciseSets)
                            {
                                <span class="set-pill">@FormatWeight(set.Weight)<span class="set-pill__x">×</span>@set.Repetitions</span>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
}

</div>

@code {
    [Parameter] public int Id { get; set; }

    private static readonly CultureInfo frFR = CultureInfo.GetCultureInfo("fr-FR");
    private WorkoutSession? session;
    private bool notFound;

    private double TotalVolume => session?.WorkoutExercises?
        .SelectMany(e => e.ExerciseSets ?? new())
        .Sum(s => s.Weight * s.Repetitions) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        var response = await Http.GetAsync($"api/workoutsessions/{Id}");
        if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            notFound = true;
        else
            session = await response.Content.ReadFromJsonAsync<WorkoutSession>();
    }

    private static string FormatDuration(TimeSpan d)
        => d.TotalHours >= 1 ? $"{(int)d.TotalHours}h{d.Minutes:D2}" : $"{d.Minutes} min";

    private static string FormatVolume(double kg)
        => kg >= 1000 ? $"{(kg / 1000).ToString("0.#", frFR)} t" : $"{kg.ToString("0", frFR)} kg";

    private static string FormatWeight(double w)
        => w % 1 == 0 ? w.ToString("0", frFR) : w.ToString("0.#", frFR);

    private static string Capitalize(string s)
        => string.IsNullOrEmpty(s) ? s : char.ToUpper(s[0]) + s[1..];
}
