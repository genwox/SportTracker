@page "/workoutsessions/{Id:int}"
@using SportTracker.Core.Models
@using System.Globalization
@inject HttpClient Http

<main class="v4-workout-detail">
    @if (isLoading) { <V4Loading /> }
    else if (notFound) { <V4State Title="Séance introuvable" Message="Cette séance n’existe pas ou n’est plus accessible." IsError="true"><V4Button Href="/workoutsessions">Retour aux séances</V4Button></V4State> }
    else if (errorMessage is not null) { <V4State Title="Impossible de charger la séance" Message="@errorMessage" IsError="true" OnRetry="LoadSessionAsync" /> }
    else if (session is not null)
    {
        <V4Header Title="@session.Name" Subtitle="@($"‹ Séances · {Capitalize(session.Date.ToString("dddd dd MMMM", Fr))}")" BackHref="/workoutsessions" />
        <section class="v4-session-summary" aria-label="Bilan de séance">
            <div><strong>@FormatDuration(session.Duration)</strong><span>durée</span></div>
            <div><strong>@FormatVolume(TotalVolume)</strong><span>volume</span></div>
            <div><strong>@(session.WorkoutExercises?.Count ?? 0)</strong><span>exercices</span></div>
        </section>
        @if (session.WorkoutExercises is null || !session.WorkoutExercises.Any())
        {
            <V4State Title="Aucun exercice" Message="Cette séance ne contient pas encore d’exercice." />
        }
        else
        {
            <section class="v4-detail-exercises" aria-label="Exercices de la séance">
                @foreach (var workoutExercise in session.WorkoutExercises)
                {
                    <article class="v4-detail-exercise">
                        <span class="v4-detail-exercise__icon" aria-hidden="true">♟</span>
                        <div><h2>@(workoutExercise.Exercise?.Name ?? $"Exercice #{workoutExercise.ExerciseId}")</h2><p>@FormatSets(workoutExercise.ExerciseSets)</p></div>
                        <span aria-hidden="true">›</span>
                    </article>
                }
            </section>
        }
    }
</main>

@code {
    [Parameter] public int Id { get; set; }
    private static readonly CultureInfo Fr = CultureInfo.GetCultureInfo("fr-FR");
    private WorkoutSession? session;
    private bool isLoading = true, notFound;
    private string? errorMessage;
    private double TotalVolume => session?.WorkoutExercises?.SelectMany(e => e.ExerciseSets ?? new()).Sum(s => s.Weight * s.Repetitions) ?? 0;
    protected override Task OnInitializedAsync() => LoadSessionAsync();
    private async Task LoadSessionAsync() { isLoading = true; notFound = false; errorMessage = null; try { var response = await Http.GetAsync($"api/workoutsessions/{Id}"); if (response.StatusCode == System.Net.HttpStatusCode.NotFound) { notFound = true; return; } if (!response.IsSuccessStatusCode) { errorMessage = $"Le serveur a répondu {(int)response.StatusCode}."; return; } session = await response.Content.ReadFromJsonAsync<WorkoutSession>(); if (session is null) errorMessage = "La réponse de la séance est invalide."; } catch (Exception) { errorMessage = "Vérifie ta connexion, puis réessaie."; } finally { isLoading = false; } }
    private static string FormatDuration(TimeSpan duration) => duration.TotalHours >= 1 ? $"{(int)duration.TotalHours} h {duration.Minutes:D2}" : $"{duration.Minutes} min";
    private static string FormatVolume(double value) => value >= 1000 ? $"{(value / 1000).ToString("0.#", Fr)} t" : $"{value.ToString("0", Fr)} kg";
    private static string FormatSets(IEnumerable<ExerciseSet>? sets) => sets is null || !sets.Any() ? "Aucune série enregistrée" : string.Join(" · ", sets.Select(set => $"{FormatWeight(set.Weight)} × {set.Repetitions}"));
    private static string FormatWeight(double weight) => weight.ToString(weight % 1 == 0 ? "0" : "0.#", Fr);
    private static string Capitalize(string value) => string.IsNullOrEmpty(value) ? value : char.ToUpper(value[0]) + value[1..];
}
