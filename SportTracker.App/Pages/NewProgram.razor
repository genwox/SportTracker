@page "/programs/new"
@using SportTracker.Core.Models
@inject HttpClient Http
@inject NavigationManager Nav

<div class="v4-program-form">
    <V4Header Title="Nouveau carnet" Subtitle="Prépare tes séances" BackHref="/programs" />
    <EditForm Model="form" OnValidSubmit="HandleSubmit"><DataAnnotationsValidator />
        <V4Card><div class="v4-field"><label for="program-name">Nom du carnet</label><InputText id="program-name" class="v4-input" @bind-Value="form.Name" placeholder="Ex. Full body" /></div><div class="v4-field"><label for="program-objective">Objectif <span>(facultatif)</span></label><InputText id="program-objective" class="v4-input" @bind-Value="form.Objective" placeholder="Ex. Reprendre en douceur" /></div><div class="v4-field"><label>Couleur</label><div class="v4-color-picker">@foreach (var color in ColorOptions) { var selected = form.ColorHex == color; <button type="button" class="@(selected ? "selected" : "")" style="background-color:@color" aria-label="Choisir la couleur @color" aria-pressed="@selected" @onclick="() => form.ColorHex = color"></button> }</div></div></V4Card>
        <section class="v4-program-sessions" aria-labelledby="sessions-title"><div><h2 id="sessions-title">Séances</h2><p>Tu pourras ajouter les exercices ensuite.</p></div>@for (var i = 0; i < sessions.Count; i++) { var index = i; <V4Card><div class="v4-session-name"><span>@(index + 1)</span><InputText class="v4-input" @bind-Value="sessions[index].Name" placeholder="Ex. Haut du corps" aria-label="@($"Nom de la séance {index + 1}")" />@if (sessions.Count > 1) { <button class="v4-icon-button" type="button" @onclick="() => sessions.RemoveAt(index)" aria-label="Supprimer cette séance">×</button> }</div></V4Card> }<V4Button Secondary="true" OnClick="AddSession">+ Ajouter une séance</V4Button></section>
        @if (errorMessage is not null) { <V4State Title="Création impossible" Message="@errorMessage" IsError="true" /> }
        <div class="v4-form-actions"><V4Button Type="submit" Disabled="isSaving">@(isSaving ? "Création…" : errorMessage is not null ? "Réessayer la création" : "Créer le carnet")</V4Button><a href="/programs">Annuler</a></div>
    </EditForm>
</div>
@code {
    private WorkoutProgram form = new(); private List<SessionForm> sessions = new() { new() }; private bool isSaving; private string? errorMessage;
    private static readonly string[] ColorOptions = ["#4A90D9", "#E57C3A", "#5BBD72", "#D94A6B", "#9B59B6", "#1ABC9C", "#E74C3C", "#F1C40F"];
    private void AddSession() => sessions.Add(new());
    private async Task HandleSubmit() { if (isSaving) return; if (string.IsNullOrWhiteSpace(form.Name)) { errorMessage = "Indique le nom de ton carnet."; return; } if (sessions.Any(session => string.IsNullOrWhiteSpace(session.Name))) { errorMessage = "Donne un nom à chaque séance."; return; } isSaving = true; errorMessage = null; form.Sessions = sessions.Select((session, index) => new WorkoutProgramSession { Name = session.Name.Trim(), Order = index }).ToList(); try { using var response = await Http.PostAsJsonAsync("api/programs", form); if (response.IsSuccessStatusCode) { var created = await response.Content.ReadFromJsonAsync<WorkoutProgram>(); Nav.NavigateTo(created is null ? "/programs" : $"/programs/{created.Id}"); return; } errorMessage = $"Le serveur a répondu {(int)response.StatusCode}. Réessaie : tes valeurs sont conservées."; } catch (Exception) { errorMessage = "Vérifie ta connexion, puis réessaie : tes valeurs sont conservées."; } finally { isSaving = false; } }
    private sealed class SessionForm { public string Name { get; set; } = string.Empty; }
}
