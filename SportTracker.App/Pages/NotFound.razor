@page "/not-found"
@layout MainLayout

<div class="not-found-page">
    <header class="auth-heading">
        <h1>Page introuvable</h1>
        <p>Retrouvons le bon chemin.</p>
    </header>

    <section class="auth-card not-found-card">
        <img src="assets/v4/037-question.png" alt="" width="86" height="86" />
        <h2>Cette page n’existe pas.</h2>
        <p>Le lien a peut-être changé. Tu peux revenir à ton accueil et reprendre ton entraînement.</p>
        <a class="auth-primary" href="/">Retour à l’accueil</a>
    </section>
</div>
