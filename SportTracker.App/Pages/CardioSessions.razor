@page "/cardiosessions"
@using SportTracker.Core.Models
@using SportTracker.Core.Enums
@using System.Globalization
@inject HttpClient Http

<div class="workouts-page">

    <div class="workouts-header">
        <h1 class="workouts-title">
            <span class="title-eyebrow">Tes</span>
            Cardio
        </h1>
        <a href="/cardiosessions/new" class="new-btn">+ Nouvelle</a>
    </div>

    @if (sessions == null)
    {
        <div class="st-skel-block">
            <div class="st-skeleton st-skel-tall"></div>
            <div class="st-skeleton st-skel-tall"></div>
            <div class="st-skeleton st-skel-tall"></div>
        </div>
    }
    else if (!sessions.Any())
    {
        <div class="empty-state">
            <p class="empty-title">Aucune séance cardio</p>
            <p class="empty-sub">Enregistre ta première sortie.</p>
            <a href="/cardiosessions/new" class="empty-cta">+ Nouvelle séance</a>
        </div>
    }
    else
    {
        <div class="cardio-list">
            @foreach (var s in sessions.OrderByDescending(s => s.Date))
            {
                var minutes = (int)s.Duration.TotalMinutes;
                <a href="/cardiosessions/@s.Id" class="cardio-card">
                    <div class="cardio-card__head">
                        <div class="cardio-card__icon">@((MarkupString)TypeIcon(s.Type))</div>
                        <div class="cardio-card__headtext">
                            <span class="cardio-card__type">@TypeLabel(s.Type)</span>
                            <span class="cardio-card__date">@Capitalize(s.Date.ToString("ddd dd MMM", frFR))</span>
                        </div>
                        <svg class="cardio-card__chevron" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                    </div>
                    <div class="cardio-card__body">
                        <div class="cardio-card__dist">
                            <span class="cardio-card__distval">@s.Distance.ToString("0.#", frFR)</span>
                            <span class="cardio-card__distunit">km</span>
                        </div>
                        <div class="cardio-card__meta">
                            @if (minutes > 0)
                            {
                                <span class="cardio-pill">@FormatDuration(s.Duration)</span>
                            }
                            @if (s.Distance > 0 && minutes > 0)
                            {
                                <span class="cardio-pill">@Pace(s.Duration, s.Distance) /km</span>
                            }
                        </div>
                    </div>
                </a>
            }
        </div>
    }

</div>

@code {
    private static readonly CultureInfo frFR = CultureInfo.GetCultureInfo("fr-FR");
    private List<CardioSession>? sessions;

    protected override async Task OnInitializedAsync()
    {
        sessions = await Http.GetFromJsonAsync<List<CardioSession>>("api/cardiosessions");
    }

    private static string TypeLabel(CardioType t) => t switch
    {
        CardioType.Run  => "Course à pied",
        CardioType.Walk => "Marche",
        CardioType.Swim => "Natation",
        CardioType.Bike => "Vélo",
        _               => t.ToString()
    };

    private static string TypeIcon(CardioType t) => t switch
    {
        CardioType.Bike => """<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="18.5" cy="17.5" r="3.5"/><path d="M15 6a1 1 0 1 0 0-2 1 1 0 0 0 0 2zM12 17.5V14l-3-3 4-3 2 3h2"/></svg>""",
        CardioType.Swim => """<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 16c1.5 0 2-1 3.5-1s2 1 3.5 1 2-1 3.5-1 2 1 3.5 1 2-1 3.5-1"/><path d="M2 20c1.5 0 2-1 3.5-1s2 1 3.5 1 2-1 3.5-1 2 1 3.5 1 2-1 3.5-1"/><circle cx="16" cy="6" r="2"/><path d="M6 12l4-2 3 2"/></svg>""",
        _ => """<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 4a2 2 0 1 0 0-.01"/><path d="M7 21l3-6 3 2 2-3"/><path d="M10 15l-2-4 4-2 2 3 3 1"/></svg>"""
    };

    private static string FormatDuration(TimeSpan d)
    {
        if (d.TotalHours >= 1) return $"{(int)d.TotalHours}h{d.Minutes:D2}";
        return d.Seconds > 0 ? $"{d.Minutes}:{d.Seconds:D2}" : $"{d.Minutes} min";
    }

    private static string Pace(TimeSpan d, double distanceKm)
    {
        var secPerKm = d.TotalSeconds / distanceKm;
        var m = (int)(secPerKm / 60);
        var s = (int)(secPerKm % 60);
        return $"{m}:{s:D2}";
    }

    private static string Capitalize(string s)
        => string.IsNullOrEmpty(s) ? s : char.ToUpper(s[0]) + s[1..];
}
