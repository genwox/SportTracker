@page "/cardiosessions"
@using SportTracker.Core.Enums
@using SportTracker.Core.Models
@using System.Globalization
@inject HttpClient Http

<div class="v4-cardio-list-page">
    <header class="v4-cardio-list-page__heading"><h1>Ton cardio</h1><p>Chaque sortie compte</p></header>
    <V4ActivityTabs />
    <V4Button Href="/cardiosessions/new">+ Nouvelle sortie</V4Button>
    @if (isLoading) { <V4Loading /> }
    else if (errorMessage is not null) { <V4State Title="Impossible de charger tes sorties" Message="@errorMessage" IsError="true" OnRetry="LoadSessionsAsync" /> }
    else if (sessions is not null && !sessions.Any()) { <V4State Title="Première sortie" Message="Enregistre ta première sortie cardio."><V4Button Href="/cardiosessions/new">Créer ma sortie</V4Button></V4State> }
    else if (sessions is not null) { <section class="v4-cardio-list" aria-label="Historique cardio">@foreach (var session in sessions.OrderByDescending(s => s.Date)) { <a class="v4-cardio-row" href="/cardiosessions/@session.Id"><span class="v4-cardio-row__icon" aria-hidden="true">@Icon(session.Type)</span><span><strong>@(string.IsNullOrWhiteSpace(session.Name) ? TypeLabel(session.Type) : session.Name)</strong><small>@Capitalize(session.Date.ToString("dddd dd MMMM", Fr)) · @FormatDuration(session.Duration)</small></span><span class="v4-cardio-row__distance">@session.Distance.ToString("0.#", Fr)<small>km</small></span><span aria-hidden="true">›</span></a> }</section> }
</div>
@code {
    private static readonly CultureInfo Fr = CultureInfo.GetCultureInfo("fr-FR"); private List<CardioSession>? sessions; private bool isLoading = true; private string? errorMessage;
    protected override Task OnInitializedAsync() => LoadSessionsAsync();
    private async Task LoadSessionsAsync() { isLoading = true; errorMessage = null; try { sessions = await Http.GetFromJsonAsync<List<CardioSession>>("api/cardiosessions") ?? new(); } catch (Exception) { errorMessage = "Vérifie ta connexion, puis réessaie."; } finally { isLoading = false; } }
    private static string TypeLabel(CardioType type) => type switch { CardioType.Run => "Course", CardioType.Walk => "Marche", CardioType.Swim => "Natation", CardioType.Bike => "Vélo", _ => type.ToString() };
    private static MarkupString Icon(CardioType type) => new(type switch
    {
        CardioType.Bike => "<svg width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><circle cx='5' cy='17' r='4'/><circle cx='19' cy='17' r='4'/><path d='M5 17l5-9 5 9H5l7-11h4'/></svg>",
        CardioType.Swim => "<svg width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><circle cx='17' cy='5' r='2'/><path d='M5 12l5-4 5 4M2 16q3-3 6 0t6 0t6 0M2 21q3-3 6 0t6 0t6 0'/></svg>",
        _ => "<svg width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><circle cx='14' cy='4' r='2'/><path d='M7 11l5-4 3 5 5 1M12 7l-2 8 5 3 1 4M10 15l-5 7'/></svg>"
    });
    private static string FormatDuration(TimeSpan duration) => duration.TotalHours >= 1 ? $"{(int)duration.TotalHours} h {duration.Minutes:D2}" : $"{duration.Minutes} min";
    private static string Capitalize(string value) => string.IsNullOrEmpty(value) ? value : char.ToUpper(value[0]) + value[1..];
}
