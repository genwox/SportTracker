@page "/profile"
@using SportTracker.Core.Models
@using SportTracker.App.Services
@using System.Globalization
@inject HttpClient Http
@inject SportTracker.App.Auth.AuthService Auth
@inject WeeklyGoalService WeeklyGoal
@inject NavigationManager Nav

<div class="profile-page">
    <V4Header Title="Ton profil" />

    @if (loading)
    {
        <V4Loading />
    }
    else if (errorMessage is not null)
    {
        <V4State Title="Impossible de charger ton profil" Message="@errorMessage" IsError="true" OnRetry="LoadAsync" />
    }
    else
    {
        <V4Card>
            <div class="pf-identity">
                <div class="pf-avatar" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#082D45" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                    </svg>
                </div>
                <div class="pf-identity__text">
                    <strong>@(email ?? "Compte")</strong>
                    @if (memberSince.HasValue)
                    {
                        <span>Membre depuis @memberSince.Value.ToString("MMMM yyyy", frFR)</span>
                    }
                </div>
            </div>
        </V4Card>

        <div class="pf-stats">
            <V4Card>
                <div class="pf-stat">
                    <span class="pf-stat__val">@totalSessions</span>
                    <span class="pf-stat__label">séances</span>
                </div>
            </V4Card>
            <V4Card>
                <div class="pf-stat">
                    <span class="pf-stat__val">@streak</span>
                    <span class="pf-stat__label">jour@(streak > 1 ? "s" : "") de suite</span>
                </div>
            </V4Card>
            <V4Card>
                <div class="pf-stat">
                    <span class="pf-stat__val">@totalMinutes</span>
                    <span class="pf-stat__label">min au total</span>
                </div>
            </V4Card>
        </div>

        <V4Card>
            <div class="pf-goal">
                <strong>@weekSessions / @weeklyGoal séance@(weeklyGoal > 1 ? "s" : "") cette semaine</strong>
                <span>@(weekSessions >= weeklyGoal ? "Objectif hebdomadaire atteint" : $"Encore {weeklyGoal - weekSessions} pour cette semaine")</span>
            </div>
        </V4Card>

        <p class="pf-section-label">Préférences et aide</p>
        <div class="pf-menu">
            <a href="/profile/preferences" class="pf-menu__item">
                <span class="pf-menu__icon" style="background:#D4F53C">
                    <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#082D45" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
                </span>
                <span class="pf-menu__label">Objectifs &amp; préférences</span>
                <svg class="pf-menu__chevron" xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </a>

            @foreach (var item in unavailableItems)
            {
                <div class="pf-menu__item pf-menu__item--disabled" aria-disabled="true">
                    <span class="pf-menu__icon" style="background:#DDF6F4">
                        @((MarkupString)item.IconSvg)
                    </span>
                    <span class="pf-menu__label">@item.Label</span>
                    <span class="pf-menu__badge">Bientôt disponible</span>
                </div>
            }

            <a href="/help" class="pf-menu__item">
                <span class="pf-menu__icon" style="background:#D4F53C">
                    <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#082D45" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 2-3 4"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                </span>
                <span class="pf-menu__label">Aide &amp; support</span>
                <svg class="pf-menu__chevron" xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </a>
        </div>

        <button class="pf-logout" @onclick="HandleLogout">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
            </svg>
            Se déconnecter
        </button>
    }
</div>

@code {
    private static readonly CultureInfo frFR = CultureInfo.GetCultureInfo("fr-FR");

    private bool loading = true;
    private string? errorMessage;
    private int totalSessions;
    private int streak;
    private int totalMinutes;
    private int weekSessions;
    private int weeklyGoal = WeeklyGoalService.DefaultGoal;
    private DateTime? memberSince;
    private string? email;

    private sealed record UnavailableItem(string Label, string IconSvg);

    private readonly List<UnavailableItem> unavailableItems =
    [
        new("Notifications",
            """<svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#082D45" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>"""),
        new("Apps connectées",
            """<svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#082D45" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>"""),
        new("Confidentialité",
            """<svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#082D45" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>"""),
    ];

    private async Task HandleLogout()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/login", replace: true);
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        errorMessage = null;

        try
        {
            // Identité et objectif passent par WeeklyGoalService : un seul appel
            // manage/info, jamais mémorisé en cas d'échec (le retry le relance).
            var workoutsTask = Http.GetFromJsonAsync<List<WorkoutSession>>("api/workoutsessions");
            var cardioTask   = Http.GetFromJsonAsync<List<CardioSession>>("api/cardiosessions");
            var emailTask    = WeeklyGoal.GetEmailAsync();
            var goalTask     = WeeklyGoal.GetGoalAsync();
            await Task.WhenAll(workoutsTask, cardioTask, emailTask, goalTask);

            var workouts = workoutsTask.Result ?? [];
            var cardio   = cardioTask.Result ?? [];
            email        = emailTask.Result;
            weeklyGoal   = goalTask.Result;

            totalSessions = workouts.Count + cardio.Count;
            totalMinutes  = (int)(workouts.Sum(s => s.Duration.TotalMinutes)
                                + cardio.Sum(s => s.Duration.TotalMinutes));

            var allDates = workouts.Select(s => s.Date.Date)
                .Concat(cardio.Select(s => s.Date.Date))
                .ToHashSet();

            streak = 0;
            var check = DateTime.Today;
            while (allDates.Contains(check)) { streak++; check = check.AddDays(-1); }

            var allSessions = workouts.Select(s => s.Date)
                .Concat(cardio.Select(s => s.Date));
            memberSince = allSessions.Any() ? allSessions.Min() : null;

            var monday = DateTime.Today.AddDays(-(((int)DateTime.Today.DayOfWeek + 6) % 7));
            weekSessions = workouts.Count(s => s.Date.Date >= monday)
                         + cardio.Count(s => s.Date.Date >= monday);
        }
        catch
        {
            errorMessage = "Impossible de récupérer tes séances.";
        }

        loading = false;
    }
}
