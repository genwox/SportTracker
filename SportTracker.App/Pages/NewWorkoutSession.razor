@page "/workoutsessions/new"
@using SportTracker.Core.Models
@inject HttpClient Http
@inject NavigationManager Nav

<div class="v4-workout-form">
    <V4Header Title="Nouvelle séance" Subtitle="‹ Retour aux séances" BackHref="/workoutsessions" />
    @if (isLoading)
    {
        <V4Loading />
    }
    else if (loadError is not null)
    {
        <V4State Title="Exercices indisponibles" Message="@loadError" IsError="true" OnRetry="LoadExercisesAsync" />
    }
    else if (availableExercises is not null && !availableExercises.Any())
    {
        <V4State Title="Aucun exercice" Message="Ajoute d’abord un exercice à ton catalogue." />
    }
    else
    {
        <EditForm Model="form" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />
            <V4Card>
                <div class="v4-field">
                    <label for="workout-name">Nom de la séance</label>
                    <InputText id="workout-name" class="v4-input" @bind-Value="form.Name" placeholder="Ex. Haut du corps" />
                </div>
                <div class="v4-form-grid">
                    <div class="v4-field"><label for="workout-date">Date</label><InputDate id="workout-date" class="v4-input" @bind-Value="form.Date" /></div>
                    <div class="v4-field"><label for="workout-duration">Durée (min)</label><InputNumber id="workout-duration" class="v4-input" @bind-Value="durationMinutes" min="1" /></div>
                </div>
            </V4Card>

            <section class="v4-exercise-editor" aria-label="Exercices et séries">
                @for (var i = 0; i < workoutExercises.Count; i++)
                {
                    var idx = i;
                    var item = workoutExercises[idx];
                    var selected = availableExercises!.FirstOrDefault(e => e.Id == item.ExerciseId);
                    var filtered = string.IsNullOrWhiteSpace(item.SearchText) ? Enumerable.Empty<Exercise>() : (availableExercises ?? []).Where(e => e.Name.Contains(item.SearchText, StringComparison.OrdinalIgnoreCase)).Take(8);
                    <V4Card>
                        <div class="v4-exercise-editor__title">
                            @if (selected is null)
                            {
                                <div class="v4-search">
                                    <input class="v4-input" placeholder="Rechercher un exercice" value="@item.SearchText" @oninput="e => item.SearchText = e.Value?.ToString() ?? string.Empty" @onfocusin="() => item.ShowDropdown = true" @onfocusout="() => item.ShowDropdown = false" />
                                    @if (item.ShowDropdown && filtered.Any())
                                    {
                                        <div class="v4-search__options">
                                            @foreach (var exercise in filtered)
                                            {
                                                <button type="button" @onmousedown:preventDefault @onclick="() => SelectExercise(idx, exercise)">@exercise.Name</button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div><h2>@selected.Name</h2><small>Exercice sélectionné · <button type="button" @onclick="() => ClearExercise(idx)">Retirer</button></small></div>
                            }
                            <button type="button" class="v4-icon-button" aria-label="Retirer l’exercice" @onclick="() => RemoveExercise(idx)">×</button>
                        </div>
                        <div class="v4-set-head"><span>Série</span><span>Poids (kg)</span><span>Reps</span><span></span></div>
                        @for (var j = 0; j < item.Sets.Count; j++)
                        {
                            var setIndex = j;
                            var set = item.Sets[setIndex];
                            <div class="v4-set-row"><span>@(setIndex + 1)</span><input type="number" @bind="set.Weight" min="0" step="0.5" aria-label="Poids série @(setIndex + 1)" /><input type="number" @bind="set.Repetitions" min="1" aria-label="Répétitions série @(setIndex + 1)" /><button type="button" aria-label="Supprimer la série @(setIndex + 1)" @onclick="() => RemoveSet(idx, setIndex)">×</button></div>
                        }
                        <button type="button" class="v4-add-set" @onclick="() => AddSet(idx)">+ Ajouter une série</button>
                    </V4Card>
                }
            </section>
            <V4Button Secondary="true" OnClick="AddExercise">+ Ajouter un exercice</V4Button>
            @if (errorMessage is not null) { <V4State Title="Enregistrement impossible" Message="@errorMessage" IsError="true" /> }
            <div class="v4-form-actions"><V4Button Type="submit" Disabled="isSaving">@(isSaving ? "Enregistrement…" : "Enregistrer la séance")</V4Button><a href="/workoutsessions">Annuler</a></div>
        </EditForm>
    }
</div>

@code {
    private WorkoutSession form = new() { Date = DateTime.Today };
    private int durationMinutes = 60;
    private List<WorkoutExerciseForm> workoutExercises = new();
    private List<Exercise>? availableExercises;
    private bool isLoading = true, isSaving;
    private string? errorMessage, loadError;
    protected override Task OnInitializedAsync() => LoadExercisesAsync();
    private async Task LoadExercisesAsync() { isLoading = true; loadError = null; try { availableExercises = await Http.GetFromJsonAsync<List<Exercise>>("api/exercises") ?? new(); } catch (Exception) { loadError = "Vérifie ta connexion, puis réessaie."; } finally { isLoading = false; } }
    private void AddExercise() => workoutExercises.Add(new());
    private void RemoveExercise(int index) => workoutExercises.RemoveAt(index);
    private void AddSet(int exerciseIndex) => workoutExercises[exerciseIndex].Sets.Add(new());
    private void RemoveSet(int exerciseIndex, int setIndex) => workoutExercises[exerciseIndex].Sets.RemoveAt(setIndex);
    private void SelectExercise(int index, Exercise exercise) { workoutExercises[index].ExerciseId = exercise.Id; workoutExercises[index].SearchText = string.Empty; workoutExercises[index].ShowDropdown = false; }
    private void ClearExercise(int index) { workoutExercises[index].ExerciseId = 0; workoutExercises[index].SearchText = string.Empty; }
    private async Task HandleSubmit() { if (workoutExercises.Any(we => we.ExerciseId == 0)) { errorMessage = "Sélectionne un exercice pour chaque bloc."; return; } isSaving = true; errorMessage = null; form.Duration = TimeSpan.FromMinutes(durationMinutes); form.WorkoutExercises = workoutExercises.Select(we => new WorkoutExercise { ExerciseId = we.ExerciseId, ExerciseSets = we.Sets }).ToList(); try { var response = await Http.PostAsJsonAsync("api/workoutsessions", form); if (response.IsSuccessStatusCode) { Nav.NavigateTo("/workoutsessions"); return; } errorMessage = $"Le serveur a répondu {(int)response.StatusCode}. Réessaie : tes valeurs sont conservées."; } catch (Exception) { errorMessage = "Vérifie ta connexion, puis réessaie : tes valeurs sont conservées."; } finally { isSaving = false; } }
    private class WorkoutExerciseForm { public int ExerciseId { get; set; } public string SearchText { get; set; } = string.Empty; public bool ShowDropdown { get; set; } public List<ExerciseSet> Sets { get; set; } = new() { new ExerciseSet() }; }
}
