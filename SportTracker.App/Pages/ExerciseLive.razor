@page "/programs/{ProgramId:int}/sessions/{SessionId:int}/exercises/{ExerciseId:int}/live"
@using System.Net
@using System.Globalization
@using SportTracker.Core.Models
@inject HttpClient Http
@implements IDisposable

<div class="v4-live">
    @if (isLoading) { <V4Loading /> }
    else if (notFound) { <V4State Title="Exercice introuvable" Message="Cet exercice ne fait pas partie de la séance, ou la séance n’est plus accessible."><V4Button Href="@SessionHref" Secondary="true">Revenir à la séance</V4Button></V4State> }
    else if (loadError is not null) { <V4State Title="Impossible de charger l’exercice" Message="@loadError" IsError="true" OnRetry="LoadAsync" /> }
    else
    {
        <header class="v4-live__header">
            <h1>@exerciseName</h1>
            <nav class="v4-live__links" aria-label="Navigation de l’exercice">
                <a href="@SessionHref">‹ Séance</a>
                <span aria-hidden="true">•</span>
                <a href="@($"{SessionHref}/exercises/{ExerciseId}/history")">Historique</a>
            </nav>
        </header>

        <ol class="v4-live__sets" aria-label="Séries">
            @for (var i = 1; i <= IndicatorCount; i++)
            {
                var done = i <= todaySets.Count;
                var active = i == ActiveOrder;
                <li class="@(done ? "is-done" : active ? "is-active" : "")" aria-current="@(active ? "step" : null)">
                    <span class="visually-hidden">Série </span>@(done ? $"✓ {i}" : i.ToString())<span class="visually-hidden">@(done ? " validée" : active ? " en cours" : " à faire")</span>
                </li>
            }
        </ol>

        @if (!string.IsNullOrEmpty(exerciseGifUrl))
        {
            <button type="button" class="v4-live__tile" @onclick="() => showGif = true">
                <span class="v4-live__icon" aria-hidden="true"><img src="assets/v4/023-weight lifting.png" alt="" /></span>
                <span class="v4-live__tile-text"><strong>Voir le mouvement</strong><small>Ouvrir la démonstration</small></span>
            </button>
        }

        @if (LastTimeText is not null)
        {
            <p class="v4-live__last">@LastTimeText</p>
        }

        <section class="v4-live__entry" aria-label="Saisie de série">
            <span class="v4-live__label" id="live-weight-label">Poids (kg)</span>
            <div class="v4-live__stepper" role="group" aria-labelledby="live-weight-label">
                <button type="button" @onclick="() => AdjustWeight(-WeightStep)" aria-label="Diminuer le poids de 2,5 kg">−</button>
                <button type="button" class="v4-live__value" @onclick="() => OpenPad(PadField.Weight)" aria-label="@($"Poids {FormatWeight(weightCurrent)} kg, saisie précise")">@FormatWeight(weightCurrent)</button>
                <button type="button" @onclick="() => AdjustWeight(WeightStep)" aria-label="Augmenter le poids de 2,5 kg">+</button>
            </div>
            <span class="v4-live__label" id="live-reps-label">Répétitions</span>
            <div class="v4-live__stepper" role="group" aria-labelledby="live-reps-label">
                <button type="button" @onclick="() => AdjustReps(-1)" aria-label="Retirer une répétition">−</button>
                <button type="button" class="v4-live__value" @onclick="() => OpenPad(PadField.Reps)" aria-label="@($"{repsCurrent} répétitions, saisie précise")">@repsCurrent</button>
                <button type="button" @onclick="() => AdjustReps(1)" aria-label="Ajouter une répétition">+</button>
            </div>
            <p class="v4-live__orm">1RM estimé : <strong>@(OneRm > 0 ? $"{FormatWeight(OneRm)} kg" : "—")</strong></p>
        </section>

        @if (restSeconds > 0)
        {
            <button type="button" class="v4-live__tile v4-live__tile--rest" @onclick="OpenTimer">
                <span class="v4-live__icon" aria-hidden="true"><img src="assets/v4/030-stopwatch.png" alt="" /></span>
                <span class="v4-live__tile-text">
                    <strong>@(TimerActive ? $"Repos en cours · {FormatClock(timerRemaining)}" : $"Repos prévu · {FormatClock(restSeconds)}")</strong>
                    <small>Ouvrir le minuteur</small>
                </span>
            </button>
        }

        @if (saveError is not null)
        {
            <V4State Title="Série non enregistrée" Message="@saveError" IsError="true" />
        }

        <div class="v4-live__actions">
            <V4Button OnClick="ValidateSetAsync" Disabled="@(isSaving || repsCurrent <= 0)">@ValidateLabel</V4Button>
            <V4Button Secondary="true" OnClick="() => OpenPad(PadField.Weight)">Saisie précise</V4Button>
        </div>
    }
</div>

@if (showPad)
{
    <div class="sheet-backdrop" @onclick="ClosePad"></div>
    <div class="sheet v4-pad" role="dialog" aria-modal="true" aria-labelledby="pad-title" tabindex="-1" @ref="padRef" @onkeydown="OnPadKeyDown">
        <div class="v4-pad__head">
            <h2 id="pad-title">Saisie précise</h2>
            <p>@exerciseName · Série @ActiveOrder</p>
        </div>
        <button type="button" class="v4-pad__close" @onclick="ClosePad">Fermer et revenir à l’exercice</button>

        <div class="v4-pad__fields">
            <div class="v4-pad__grid">
                <button type="button" class="v4-pad__field @(padField == PadField.Weight ? "is-active" : "")" aria-pressed="@(padField == PadField.Weight)" @onclick="() => padField = PadField.Weight">
                    <span>Poids (kg)</span><output>@(weightInput.Length > 0 ? weightInput : "—")</output>
                </button>
                <button type="button" class="v4-pad__field @(padField == PadField.Reps ? "is-active" : "")" aria-pressed="@(padField == PadField.Reps)" @onclick="() => padField = PadField.Reps">
                    <span>Répétitions</span><output>@(repsInput.Length > 0 ? repsInput : "—")</output>
                </button>
            </div>
            <p aria-live="polite">Champ actif : @(padField == PadField.Weight ? "poids" : "répétitions")</p>
        </div>

        <div class="v4-pad__keys">
            @foreach (var key in PadKeys)
            {
                var k = key;
                <button type="button" disabled="@(k == "," && padField == PadField.Reps)" aria-label="@(k == "⌫" ? "Effacer" : k == "," ? "Virgule" : null)" @onclick="() => PressKey(k)">@k</button>
            }
        </div>

        <V4Button Secondary="true" OnClick="SetBodyweight">Poids du corps</V4Button>
        <V4Button OnClick="ApplyPad">Appliquer les valeurs</V4Button>
    </div>
}

@if (showTimer)
{
    <div class="v4-timer" role="dialog" aria-modal="true" aria-labelledby="timer-title" tabindex="-1" @ref="timerRef" @onkeydown="OnOverlayKeyDown">
        <div class="v4-timer__inner">
            <div class="v4-timer__head">
                <h2 id="timer-title">Temps de repos</h2>
                <p>@(todaySets.Count > 0 ? $"Série {todaySets.Count} validée · {exerciseName}" : exerciseName)</p>
            </div>
            <section class="v4-timer__card">
                <div class="v4-timer__dial">
                    <svg viewBox="0 0 250 250" aria-hidden="true">
                        <circle class="v4-timer__track" cx="125" cy="125" r="@DialRadius" />
                        <circle class="v4-timer__progress" cx="125" cy="125" r="@DialRadius" style="@($"stroke-dasharray:{Inv(DialCircumference)};stroke-dashoffset:{Inv(DialOffset)}")" />
                    </svg>
                    <span role="timer" aria-live="off">@FormatClock(timerRemaining)</span>
                </div>
                <p>@(timerFinished ? "Repos terminé" : $"sur {FormatRestLong(restSeconds)} de repos")</p>
                <V4Button OnClick="ToggleTimer">@(timerFinished ? "Relancer le repos" : timerRunning ? "Mettre en pause" : TimerActive ? "Reprendre" : "Démarrer le repos")</V4Button>
            </section>
            <p class="v4-timer__hint" aria-live="polite">@(timerFinished ? "C’est reparti : la série suivante t’attend." : "Respire. La prochaine série t’attend.")</p>
            <V4Button Secondary="true" OnClick="CloseTimer">Revenir à l’exercice</V4Button>
        </div>
    </div>
}

@if (showGif && !string.IsNullOrEmpty(exerciseGifUrl))
{
    <div class="gif-viewer" role="dialog" aria-modal="true" aria-label="@($"Démonstration : {exerciseName}")" tabindex="-1" @ref="gifRef" @onkeydown="OnOverlayKeyDown" @onclick="() => showGif = false">
        <button type="button" class="gif-viewer__close" @onclick="() => showGif = false" aria-label="Fermer la démonstration">✕</button>
        <div class="gif-viewer__inner" @onclick:stopPropagation>
            <img src="@exerciseGifUrl" alt="@exerciseName" class="gif-viewer__img" />
            <h2 class="gif-viewer__title">@exerciseName</h2>
            @if (!string.IsNullOrEmpty(exerciseInstructions))
            {
                <p class="gif-viewer__instructions">@exerciseInstructions</p>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int ProgramId { get; set; }
    [Parameter] public int SessionId { get; set; }
    [Parameter] public int ExerciseId { get; set; }

    private enum PadField { Weight, Reps }
    private static readonly string[] PadKeys = { "1", "2", "3", "4", "5", "6", "7", "8", "9", ",", "0", "⌫" };
    private const double WeightStep = 2.5;
    private const double DialRadius = 112;

    private bool isLoading = true;
    private bool notFound;
    private string? loadError;

    private string exerciseName = "";
    private string? exerciseGifUrl;
    private string? exerciseInstructions;
    private int restSeconds;
    private int targetSets;
    private int workoutProgramSessionId;

    private List<TodaySet> todaySets = new();
    private List<HistoryEntry> history = new();

    private double weightCurrent;
    private int repsCurrent;
    private bool isSaving;
    private string? saveError;

    private bool showPad;
    private PadField padField;
    private string weightInput = "";
    private string repsInput = "";

    private bool showGif;
    private bool showTimer;
    private int timerRemaining;
    private bool timerRunning;
    private bool timerFinished;
    private System.Timers.Timer? timer;

    private ElementReference padRef;
    private ElementReference timerRef;
    private ElementReference gifRef;
    private bool focusPad, focusTimer, focusGif, gifWasOpen;

    private string SessionHref => $"/programs/{ProgramId}/sessions/{SessionId}";
    private int ActiveOrder => todaySets.Count + 1;
    private int IndicatorCount => Math.Max(targetSets, ActiveOrder);
    private bool TimerActive => timerRunning || (timerRemaining > 0 && timerRemaining < restSeconds);
    private string ValidateLabel => isSaving ? "Enregistrement…" : saveError is not null ? "Réessayer" : $"Valider la série {ActiveOrder}";

    // Epley : 1RM ≈ poids × (1 + reps/30), même formule que l'historique.
    private double OneRm => weightCurrent > 0 && repsCurrent > 0 ? Math.Round(weightCurrent * (1 + repsCurrent / 30.0), 1) : 0;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true; notFound = false; loadError = null; saveError = null;
        StopTimer(); showTimer = false; timerFinished = false;
        try
        {
            var programTask = Http.GetAsync($"api/programs/{ProgramId}");
            var historyTask = Http.GetAsync($"api/exercises/{ExerciseId}/history");
            await Task.WhenAll(programTask, historyTask);
            var programResponse = programTask.Result;
            var historyResponse = historyTask.Result;

            if (programResponse.StatusCode == HttpStatusCode.NotFound || historyResponse.StatusCode == HttpStatusCode.NotFound) { notFound = true; return; }
            if (!programResponse.IsSuccessStatusCode) { loadError = $"Le serveur a répondu {(int)programResponse.StatusCode}."; return; }
            if (!historyResponse.IsSuccessStatusCode) { loadError = $"Le serveur a répondu {(int)historyResponse.StatusCode}."; return; }

            var program = await programResponse.Content.ReadFromJsonAsync<WorkoutProgram>();
            history = await historyResponse.Content.ReadFromJsonAsync<List<HistoryEntry>>() ?? new();

            var session = program?.Sessions.FirstOrDefault(s => s.Id == SessionId);
            var pe = session?.Exercises.OrderBy(e => e.Order).FirstOrDefault(e => e.ExerciseId == ExerciseId);
            if (session is null || pe is null) { notFound = true; return; }

            workoutProgramSessionId = session.Id;
            exerciseName = pe.Exercise?.Name ?? "Exercice";
            exerciseGifUrl = pe.Exercise?.GifUrl;
            exerciseInstructions = pe.Exercise?.InstructionsFr;
            targetSets = pe.TargetSets;
            restSeconds = Math.Max(0, pe.RestSeconds);
            timerRemaining = restSeconds;

            var todayEntry = history.FirstOrDefault(h => h.Date.Date == DateTime.Today);
            todaySets = todayEntry?.Sets.OrderBy(s => s.Order)
                .Select(s => new TodaySet { Order = s.Order, Repetitions = s.Repetitions, Weight = s.Weight })
                .ToList() ?? new();

            InitCurrentValues(pe);
        }
        catch (Exception) { loadError = "Vérifie ta connexion, puis réessaie."; }
        finally { isLoading = false; }
    }

    private void InitCurrentValues(WorkoutProgramExercise pe)
    {
        var lastToday = todaySets.LastOrDefault();
        if (lastToday is not null) { weightCurrent = lastToday.Weight; repsCurrent = lastToday.Repetitions; return; }

        var refSet = PreviousEntry?.Sets.OrderBy(s => s.Order).FirstOrDefault();
        if (refSet is not null) { weightCurrent = refSet.Weight; repsCurrent = refSet.Repetitions; }
        else { weightCurrent = 20; repsCurrent = pe.TargetRepsMin > 0 ? pe.TargetRepsMin : 10; }
    }

    private HistoryEntry? PreviousEntry => history.Where(h => h.Date.Date != DateTime.Today).OrderByDescending(h => h.Date).FirstOrDefault();

    private string? LastTimeText
    {
        get
        {
            var entry = PreviousEntry;
            if (entry is null || entry.Sets.Count == 0) return null;
            var match = entry.Sets.FirstOrDefault(s => s.Order == ActiveOrder) ?? entry.Sets.OrderByDescending(s => s.Order).First();
            return $"Dernière fois, série {match.Order} : {FormatWeight(match.Weight)} kg × {match.Repetitions} reps";
        }
    }

    private void AdjustWeight(double delta) => weightCurrent = Math.Max(0, Math.Round((weightCurrent + delta) * 100) / 100);
    private void AdjustReps(int delta) => repsCurrent = Math.Max(0, repsCurrent + delta);

    // ── Saisie précise ────────────────────────────────────────
    private void OpenPad(PadField field)
    {
        weightInput = weightCurrent > 0 ? FormatWeight(weightCurrent) : "";
        repsInput = repsCurrent > 0 ? repsCurrent.ToString(CultureInfo.InvariantCulture) : "";
        padField = field;
        showPad = true;
        focusPad = true;
    }

    private void ClosePad() => showPad = false;

    private void PressKey(string key)
    {
        if (padField == PadField.Reps)
        {
            if (key == "⌫") repsInput = repsInput.Length > 0 ? repsInput[..^1] : "";
            else if (key != "," && repsInput.Length < 3) repsInput = repsInput == "0" ? key : repsInput + key;
            return;
        }

        if (key == "⌫") { weightInput = weightInput.Length > 0 ? weightInput[..^1] : ""; return; }
        var comma = weightInput.IndexOf(',');
        if (key == ",")
        {
            if (comma < 0) weightInput = (weightInput.Length == 0 ? "0" : weightInput) + ",";
            return;
        }
        if (comma >= 0 ? weightInput.Length - comma > 2 : weightInput.Length >= 4) return;
        weightInput = weightInput == "0" ? key : weightInput + key;
    }

    private void SetBodyweight()
    {
        weightInput = "0";
        padField = PadField.Reps;
    }

    private void ApplyPad()
    {
        if (double.TryParse(weightInput.TrimEnd(',').Replace(',', '.'), NumberStyles.Number, CultureInfo.InvariantCulture, out var weight) && weight >= 0)
            weightCurrent = weight;
        if (int.TryParse(repsInput, out var reps) && reps >= 0)
            repsCurrent = reps;
        showPad = false;
    }

    private void OnPadKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") { ClosePad(); return; }
        if (e.Key.Length == 1 && char.IsDigit(e.Key[0])) PressKey(e.Key);
        else if (e.Key is "," or ".") PressKey(",");
        else if (e.Key == "Backspace") PressKey("⌫");
    }

    private void OnOverlayKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return;
        if (showGif) showGif = false;
        else CloseTimer();
    }

    // ── Validation de série ───────────────────────────────────
    private async Task ValidateSetAsync()
    {
        if (isSaving || repsCurrent <= 0) return;
        isSaving = true;
        saveError = null;
        try
        {
            var response = await Http.PostAsJsonAsync($"api/exercises/{ExerciseId}/log",
                new { workoutProgramSessionId, repetitions = repsCurrent, weight = weightCurrent });
            if (!response.IsSuccessStatusCode)
            {
                saveError = $"Le serveur a répondu {(int)response.StatusCode}. Réessaie : tes valeurs sont conservées.";
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<TodaySet>();
            todaySets.Add(result ?? new TodaySet { Order = ActiveOrder, Repetitions = repsCurrent, Weight = weightCurrent });
            if (restSeconds > 0)
            {
                StartTimer();
                OpenTimer();
            }
        }
        catch (Exception) { saveError = "Vérifie ta connexion, puis réessaie : tes valeurs sont conservées."; }
        finally { isSaving = false; }
    }

    // ── Minuteur de repos ─────────────────────────────────────
    private void OpenTimer()
    {
        showTimer = true;
        focusTimer = true;
    }

    private void CloseTimer() => showTimer = false;

    private void StartTimer()
    {
        StopTimer();
        timerRemaining = restSeconds;
        timerFinished = false;
        RunTimer();
    }

    private void RunTimer()
    {
        timer = new System.Timers.Timer(1000);
        timer.Elapsed += OnTimerTick;
        timer.Start();
        timerRunning = true;
    }

    private void StopTimer()
    {
        timer?.Stop();
        timer?.Dispose();
        timer = null;
        timerRunning = false;
    }

    private void ToggleTimer()
    {
        if (timerRunning) StopTimer();
        else if (timerFinished || timerRemaining <= 0 || timerRemaining >= restSeconds) StartTimer();
        else RunTimer();
    }

    private void OnTimerTick(object? sender, System.Timers.ElapsedEventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            if (!timerRunning) return;
            timerRemaining = Math.Max(0, timerRemaining - 1);
            if (timerRemaining == 0) { StopTimer(); timerFinished = true; }
            StateHasChanged();
        });
    }

    private double DialCircumference => 2 * Math.PI * DialRadius;
    private double DialOffset => restSeconds > 0 ? DialCircumference * (1 - Math.Clamp((double)timerRemaining / restSeconds, 0, 1)) : 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (showGif && !gifWasOpen) focusGif = true;
        gifWasOpen = showGif;

        try
        {
            if (focusPad && showPad) { focusPad = false; await padRef.FocusAsync(); }
            if (focusTimer && showTimer) { focusTimer = false; await timerRef.FocusAsync(); }
            if (focusGif && showGif) { focusGif = false; await gifRef.FocusAsync(); }
        }
        catch (Exception) { /* élément retiré entre-temps */ }
    }

    // ── Formatage ─────────────────────────────────────────────
    private static string Inv(double value) => value.ToString("F2", CultureInfo.InvariantCulture);

    private static string FormatClock(int totalSeconds) => $"{totalSeconds / 60}:{totalSeconds % 60:D2}";

    private static string FormatRestLong(int seconds)
    {
        var m = seconds / 60;
        var s = seconds % 60;
        if (m == 0) return $"{s} s";
        return s > 0 ? $"{m} min {s:D2}" : $"{m} min";
    }

    private static string FormatWeight(double w) => w.ToString("0.##", CultureInfo.InvariantCulture).Replace('.', ',');

    public void Dispose() => StopTimer();

    private class TodaySet
    {
        public int Order { get; set; }
        public int Repetitions { get; set; }
        public double Weight { get; set; }
    }

    private class HistoryEntry
    {
        public DateTime Date { get; set; }
        public List<TodaySet> Sets { get; set; } = new();
    }
}
