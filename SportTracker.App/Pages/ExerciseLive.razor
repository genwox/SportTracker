@page "/programs/{ProgramId:int}/sessions/{SessionId:int}/exercises/{ExerciseId:int}/live"
@using SportTracker.Core.Models
@using System.Timers
@using System.Globalization
@inject HttpClient Http
@implements IDisposable

<div class="workouts-page live-page">

    <div class="live-topbar">
        <a href="/programs/@ProgramId/sessions/@SessionId" class="back-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"/>
            </svg>
        </a>
        <a href="/programs/@ProgramId/sessions/@SessionId/exercises/@ExerciseId/history" class="history-link">Historique</a>
    </div>

    @if (loading)
    {
        <div class="st-skel-block">
            <div class="st-skeleton st-skel-sm"></div>
            <div class="st-skeleton st-skel-tall"></div>
            <div class="st-skeleton st-skel-med"></div>
        </div>
    }
    else if (loadError is not null)
    {
        <div class="error-card">@loadError</div>
    }
    else
    {
        <header class="live-header">
            <div class="live-header__top">
                @if (exerciseTotal > 0)
                {
                    <span class="live-eyebrow">Exercice @exerciseIndex / @exerciseTotal</span>
                }
                else
                {
                    <span class="live-eyebrow">En direct</span>
                }
                @if (indicatorCount > 0)
                {
                    <div class="live-dots">
                        @for (var i = 1; i <= indicatorCount; i++)
                        {
                            var state = i <= todaySets.Count ? "done" : (i == ActiveOrder ? "active" : "todo");
                            <span class="live-dot live-dot--@state">
                                @if (state == "done")
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                                }
                                else
                                {
                                    @i
                                }
                            </span>
                        }
                    </div>
                }
            </div>

            <h1 class="live-title">@exerciseName</h1>

            @if (schemaPills.Count > 0)
            {
                <div class="live-pills">
                    @foreach (var pill in schemaPills)
                    {
                        <span class="live-pill">@pill</span>
                    }
                </div>
            }
        </header>

        @if (!string.IsNullOrEmpty(exerciseGifUrl))
        {
            <button type="button" class="live-movement" @onclick="() => showGif = true">
                <img src="@exerciseGifUrl" alt="@exerciseName" class="live-movement__thumb" loading="lazy" />
                <span class="live-movement__text">
                    <span class="live-movement__title">Voir le mouvement</span>
                    <span class="live-movement__hint">Appuie pour agrandir le GIF</span>
                </span>
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M9 21H3v-6"/><path d="M21 3l-7 7"/><path d="M3 21l7-7"/></svg>
            </button>
        }

        @if (LastTimeText is not null)
        {
            <section class="live-lasttime">
                <span class="live-lasttime__label">Dernière fois@(lastTimeOrderLabel)</span>
                <span class="live-lasttime__value">@LastTimeText</span>
            </section>
        }

        <section class="live-pad glass-hero">
            <div class="live-stepper">
                <span class="live-stepper__label">Poids (kg)</span>
                <div class="live-stepper__row">
                    <button type="button" class="live-step-btn" @onclick="() => AdjustWeight(-weightStep)" aria-label="Diminuer le poids">−</button>
                    <button type="button" class="live-stepper__value" @onclick="OpenSheet">@FormatWeight(weightCurrent)</button>
                    <button type="button" class="live-step-btn" @onclick="() => AdjustWeight(weightStep)" aria-label="Augmenter le poids">+</button>
                </div>
            </div>

            <div class="live-stepper">
                <span class="live-stepper__label">Reps</span>
                <div class="live-stepper__row">
                    <button type="button" class="live-step-btn" @onclick="() => AdjustReps(-1)" aria-label="Diminuer les reps">−</button>
                    <button type="button" class="live-stepper__value" @onclick="OpenSheet">@repsCurrent</button>
                    <button type="button" class="live-step-btn" @onclick="() => AdjustReps(1)" aria-label="Augmenter les reps">+</button>
                </div>
            </div>

            @if (restSeconds > 0)
            {
                <button type="button" class="live-restchip" @onclick="OpenFullscreenTimer">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2 2"/><path d="M5 3 2 6"/><path d="m22 6-3-3"/></svg>
                    <span class="live-restchip__text">
                        <span class="live-restchip__label">@(timerRunning || timerRemaining < restSeconds ? "Repos" : "Repos prévu")</span>
                        <span class="live-restchip__time">@FormatTime(timerRunning || timerRemaining < restSeconds ? timerRemaining : restSeconds)</span>
                    </span>
                </button>
            }
        </section>
    }

</div>

@if (!loading && loadError is null)
{
    <div class="live-floating">
        <button type="button" class="live-fab" @onclick="OpenSheet" aria-label="Saisie précise">
            <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="8" y1="10" x2="16" y2="10"/><line x1="8" y1="14" x2="12" y2="14"/></svg>
        </button>
        <button type="button" class="live-cta" @onclick="ValidateSetAsync" disabled="@isSaving">
            @(isSaving ? "Enregistrement…" : $"Valider la série {ActiveOrder}")
        </button>
    </div>
}

@if (showFullscreenTimer)
{
    <div class="fs-timer" @onclick="() => showFullscreenTimer = false">
        <svg class="fs-timer__ring" viewBox="0 0 280 280" @onclick:stopPropagation>
            <circle class="fs-timer__ring-bg" cx="140" cy="140" r="120"/>
            <circle class="fs-timer__ring-progress" cx="140" cy="140" r="120"
                style="@($"stroke-dasharray:{TimerCircumferenceStr};stroke-dashoffset:{TimerDashOffsetStr}")"/>
        </svg>
        <div class="fs-timer__content" @onclick:stopPropagation>
            <span class="fs-timer__time">@FormatTime(timerRemaining)</span>
            <span class="fs-timer__label">repos</span>
        </div>
        <button class="fs-timer__toggle" @onclick:stopPropagation @onclick="ToggleTimer">
            @if (timerRunning)
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
                    <rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/>
                </svg>
            }
            else
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
                    <polygon points="5 3 19 12 5 21 5 3"/>
                </svg>
            }
        </button>
    </div>
}

@if (showGif && !string.IsNullOrEmpty(exerciseGifUrl))
{
    <div class="gif-viewer" @onclick="() => showGif = false">
        <button type="button" class="gif-viewer__close" @onclick="() => showGif = false" aria-label="Fermer">✕</button>
        <div class="gif-viewer__inner" @onclick:stopPropagation>
            <img src="@exerciseGifUrl" alt="@exerciseName" class="gif-viewer__img" />
            <h2 class="gif-viewer__title">@exerciseName</h2>
            @if (!string.IsNullOrEmpty(exerciseInstructions))
            {
                <p class="gif-viewer__instructions">@exerciseInstructions</p>
            }
        </div>
    </div>
}

@if (showSheet)
{
    <div class="sheet-backdrop" @onclick="CloseSheet"></div>
    <div class="sheet">
        <div class="sheet-header">
            <button type="button" class="sheet-close" @onclick="CloseSheet">✕</button>
        </div>

        <div class="numpad-section">
            <div class="numpad-label">
                <span>Nombre de répétitions</span>
                <span class="numpad-value">@(string.IsNullOrEmpty(repsInput) ? "—" : repsInput)</span>
            </div>
            <div class="numpad-grid">
                @foreach (var key in new[] { "1","2","3","4","5","6","7","8","9","0","","Effacer" })
                {
                    @if (key == "")
                    {
                        <span class="numpad-spacer"></span>
                    }
                    else
                    {
                        var k = key;
                        <button type="button" class="numpad-btn" @onclick="() => PressReps(k)">@k</button>
                    }
                }
            </div>
        </div>

        <div class="numpad-section">
            <div class="numpad-label">
                <span>Charge</span>
                <span class="numpad-value">@(string.IsNullOrEmpty(weightInput) ? "—" : weightInput) kg</span>
            </div>
            <div class="numpad-grid">
                @foreach (var key in new[] { "1","2","3","4","5","6","7","8","9","0","PDC","Effacer" })
                {
                    var k = key;
                    <button type="button" class="numpad-btn @(k == "PDC" ? "numpad-btn--pdc" : "")" @onclick="() => PressWeight(k)">@k</button>
                }
            </div>
        </div>

        <button type="button" class="submit-btn" @onclick="ApplyNumpad">
            Appliquer
        </button>
    </div>
}

@code {
    [Parameter] public int ProgramId { get; set; }
    [Parameter] public int SessionId { get; set; }
    [Parameter] public int ExerciseId { get; set; }

    private bool loading = true;
    private string? loadError;
    private bool showFullscreenTimer;
    private bool showGif;
    private string exerciseName = "";
    private string? exerciseGifUrl;
    private string? exerciseInstructions;
    private int restSeconds;
    private int workoutProgramSessionId;

    private int exerciseIndex;
    private int exerciseTotal;
    private int targetSets;
    private readonly List<string> schemaPills = new();

    private List<TodaySet> todaySets = new();
    private List<HistoryEntry> history = new();

    private bool showSheet;
    private string repsInput = "";
    private string weightInput = "";
    private bool isSaving;

    // Central pad current values (source de vérité pour la validation)
    private double weightCurrent;
    private int repsCurrent;
    private const double weightStep = 2.5;

    private int timerRemaining;
    private bool timerRunning;
    private System.Timers.Timer? timer;

    private int ActiveOrder => todaySets.Count + 1;
    private int indicatorCount => Math.Max(targetSets, ActiveOrder);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var programTask = Http.GetFromJsonAsync<WorkoutProgram>($"api/programs/{ProgramId}");
            var historyTask = Http.GetFromJsonAsync<List<HistoryEntry>>($"api/exercises/{ExerciseId}/history");
            await Task.WhenAll(programTask, historyTask);

            var program = programTask.Result;
            history = historyTask.Result ?? new();

            var session = program?.Sessions.FirstOrDefault(s => s.Id == SessionId);
            if (session != null)
                workoutProgramSessionId = session.Id;

            var exercises = session?.Exercises.ToList() ?? new();
            exerciseTotal = exercises.Count;
            var idx = exercises.FindIndex(e => e.ExerciseId == ExerciseId);
            exerciseIndex = idx >= 0 ? idx + 1 : 0;

            var pe = exercises.FirstOrDefault(e => e.ExerciseId == ExerciseId);
            var exercise = pe?.Exercise;

            exerciseName = exercise?.Name ?? "Exercice";
            exerciseGifUrl = exercise?.GifUrl;
            exerciseInstructions = exercise?.InstructionsFr;

            if (pe is not null)
            {
                targetSets = pe.TargetSets;
                restSeconds = pe.RestSeconds;

                var reps = pe.TargetRepsMin == pe.TargetRepsMax
                    ? $"{pe.TargetRepsMin} reps"
                    : $"{pe.TargetRepsMin}-{pe.TargetRepsMax} reps";
                schemaPills.Add($"{pe.TargetSets} séries");
                schemaPills.Add(reps);
                schemaPills.Add($"Repos {FormatRest(pe.RestSeconds)}");
            }

            var todayEntry = history.FirstOrDefault(h => h.Date.Date == DateTime.Today);
            if (todayEntry != null)
            {
                todaySets = todayEntry.Sets.Select(s => new TodaySet
                {
                    Order = s.Order,
                    Repetitions = s.Repetitions,
                    Weight = s.Weight
                }).ToList();
            }

            timerRemaining = restSeconds;
            InitCurrentValues(pe);
        }
        catch (Exception ex)
        {
            loadError = $"Erreur de chargement : {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private void InitCurrentValues(WorkoutProgramExercise? pe)
    {
        var lastToday = todaySets.LastOrDefault();
        if (lastToday != null)
        {
            weightCurrent = lastToday.Weight;
            repsCurrent = lastToday.Repetitions;
            return;
        }

        var lastEntry = history.Where(h => h.Date.Date != DateTime.Today)
                               .OrderByDescending(h => h.Date)
                               .FirstOrDefault();
        var refSet = lastEntry?.Sets.OrderBy(s => s.Order).FirstOrDefault();
        if (refSet != null)
        {
            weightCurrent = refSet.Weight;
            repsCurrent = refSet.Repetitions;
        }
        else
        {
            weightCurrent = 20;
            repsCurrent = pe?.TargetRepsMin > 0 ? pe.TargetRepsMin : 10;
        }
    }

    // ── Dernière fois (séance précédente) ─────────────────────
    private string lastTimeOrderLabel = "";
    private string? LastTimeText
    {
        get
        {
            var lastEntry = history.Where(h => h.Date.Date != DateTime.Today)
                                   .OrderByDescending(h => h.Date)
                                   .FirstOrDefault();
            if (lastEntry == null || lastEntry.Sets.Count == 0) return null;

            var match = lastEntry.Sets.FirstOrDefault(s => s.Order == ActiveOrder)
                        ?? lastEntry.Sets.OrderByDescending(s => s.Order).First();
            lastTimeOrderLabel = $" (Série {match.Order})";
            return $"{FormatWeight(match.Weight)} kg × {match.Repetitions}";
        }
    }

    private void AdjustWeight(double delta)
    {
        weightCurrent = Math.Max(0, Math.Round((weightCurrent + delta) * 100) / 100);
    }

    private void AdjustReps(int delta)
    {
        repsCurrent = Math.Max(0, repsCurrent + delta);
    }

    private void OpenSheet()
    {
        repsInput = repsCurrent > 0 ? repsCurrent.ToString() : "";
        weightInput = weightCurrent > 0 ? weightCurrent.ToString("0.##", CultureInfo.InvariantCulture) : "";
        showSheet = true;
    }

    private void CloseSheet() => showSheet = false;

    private void PressReps(string key)
    {
        if (key == "Effacer")
            repsInput = repsInput.Length > 0 ? repsInput[..^1] : "";
        else
            repsInput += key;
    }

    private void PressWeight(string key)
    {
        if (key == "Effacer")
            weightInput = weightInput.Length > 0 ? weightInput[..^1] : "";
        else if (key == "PDC")
            weightInput = "0";
        else
            weightInput += key;
    }

    private void ApplyNumpad()
    {
        if (int.TryParse(repsInput, out var reps) && reps >= 0)
            repsCurrent = reps;
        if (double.TryParse(weightInput, NumberStyles.Any, CultureInfo.InvariantCulture, out var weight) && weight >= 0)
            weightCurrent = weight;
        showSheet = false;
    }

    private void OpenFullscreenTimer() => showFullscreenTimer = true;

    private async Task ValidateSetAsync()
    {
        if (repsCurrent <= 0) return;

        isSaving = true;
        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/exercises/{ExerciseId}/log",
                new { workoutProgramSessionId, repetitions = repsCurrent, weight = weightCurrent });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<LogSetResult>();
                if (result != null)
                    todaySets.Add(new TodaySet
                    {
                        Order = result.Order,
                        Repetitions = result.Repetitions,
                        Weight = result.Weight
                    });
                StartTimer();
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private void StartTimer()
    {
        timer?.Stop();
        timer?.Dispose();
        timerRemaining = restSeconds;
        timerRunning = true;
        timer = new System.Timers.Timer(1000);
        timer.Elapsed += OnTimerTick;
        timer.Start();
    }

    private void ToggleTimer()
    {
        if (timerRunning)
        {
            timer?.Stop();
            timerRunning = false;
        }
        else
        {
            if (timerRemaining <= 0) timerRemaining = restSeconds;
            timer?.Dispose();
            timer = new System.Timers.Timer(1000);
            timer.Elapsed += OnTimerTick;
            timer.Start();
            timerRunning = true;
        }
    }

    private void OnTimerTick(object? sender, ElapsedEventArgs e)
    {
        timerRemaining--;
        if (timerRemaining <= 0)
        {
            timer?.Stop();
            timerRunning = false;
            timerRemaining = restSeconds;
        }
        InvokeAsync(StateHasChanged);
    }

    private double TimerCircumference => 2 * Math.PI * 120;
    private double TimerDashOffset => restSeconds > 0
        ? TimerCircumference * (1.0 - Math.Clamp((double)timerRemaining / restSeconds, 0, 1))
        : 0;
    private string TimerCircumferenceStr => TimerCircumference.ToString("F2", CultureInfo.InvariantCulture);
    private string TimerDashOffsetStr => TimerDashOffset.ToString("F2", CultureInfo.InvariantCulture);

    private string FormatTime(int totalSeconds)
    {
        var m = totalSeconds / 60;
        var s = totalSeconds % 60;
        return $"{m:D2}:{s:D2}";
    }

    private string FormatRest(int seconds)
    {
        if (seconds >= 60)
        {
            var m = seconds / 60;
            var s = seconds % 60;
            return s > 0 ? $"{m}min{s:D2}" : $"{m}min";
        }
        return $"{seconds}s";
    }

    private string FormatWeight(double w)
        => w % 1 == 0 ? w.ToString("0", CultureInfo.InvariantCulture) : w.ToString("0.##", CultureInfo.InvariantCulture);

    public void Dispose()
    {
        timer?.Stop();
        timer?.Dispose();
    }

    private class TodaySet
    {
        public int Order { get; set; }
        public int Repetitions { get; set; }
        public double Weight { get; set; }
    }

    private class LogSetResult
    {
        public int Order { get; set; }
        public int Repetitions { get; set; }
        public double Weight { get; set; }
    }

    private class HistoryEntry
    {
        public DateTime Date { get; set; }
        public int TotalReps { get; set; }
        public double TotalVolume { get; set; }
        public List<SetEntry> Sets { get; set; } = new();
    }

    private class SetEntry
    {
        public int Order { get; set; }
        public int Repetitions { get; set; }
        public double Weight { get; set; }
    }
}
