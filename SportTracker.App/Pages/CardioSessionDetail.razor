@page "/cardiosessions/{Id:int}"
@using SportTracker.Core.Models
@using SportTracker.Core.Enums
@using System.Globalization
@inject HttpClient Http
@inject NavigationManager Nav

<div class="detail-page">

@if (session is null && !notFound)
{
    <div class="st-skel-block" style="padding-top:52px">
        <div class="st-skel-row" style="align-items:center; gap:12px; margin-bottom:8px;">
            <div class="st-skeleton" style="width:38px;height:38px;border-radius:50%;flex-shrink:0"></div>
            <div class="st-skeleton st-skel-line" style="width:55%; height:28px"></div>
        </div>
        <div class="st-skeleton" style="height:200px"></div>
        <div class="st-skel-row">
            <div class="st-skeleton st-skel-sm" style="flex:1"></div>
            <div class="st-skeleton st-skel-sm" style="flex:1"></div>
        </div>
    </div>
}
else if (notFound)
{
    <div class="not-found">
        <p>Séance introuvable.</p>
        <a href="/history" class="back-btn">← Retour</a>
    </div>
}
else
{
    <div class="detail-header">
        <a href="/history" class="back-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"/>
            </svg>
        </a>
        <h1 class="detail-title">@session!.Name</h1>
    </div>

    <div class="hero-card">
        <p class="hero-label">@TypeLabel(session.Type).ToUpper()</p>
        <p class="hero-value">@session.Distance.ToString("0.#", frFR)</p>
        <p class="hero-unit">kilomètres</p>
    </div>

    <div class="stats-grid">
        <div class="stat-tile">
            <p class="stat-tile__val">@FormatDuration(session.Duration)</p>
            <p class="stat-tile__lbl">Durée</p>
        </div>
        @if (session.Distance > 0 && session.Duration.TotalSeconds > 0)
        {
            <div class="stat-tile">
                <p class="stat-tile__val">@Pace(session.Duration, session.Distance) <span class="stat-tile__unit">/km</span></p>
                <p class="stat-tile__lbl">Allure</p>
            </div>
        }
        <div class="stat-tile">
            <p class="stat-tile__val">@Capitalize(session.Date.ToString("ddd dd MMM", frFR))</p>
            <p class="stat-tile__lbl">Date</p>
        </div>
        @if (session.ElevationGain > 0)
        {
            <div class="stat-tile">
                <p class="stat-tile__val">@session.ElevationGain <span class="stat-tile__unit">m</span></p>
                <p class="stat-tile__lbl">Dénivelé</p>
            </div>
        }
    </div>
}

</div>

@code {
    [Parameter] public int Id { get; set; }

    private static readonly CultureInfo frFR = CultureInfo.GetCultureInfo("fr-FR");
    private CardioSession? session;
    private bool notFound;

    protected override async Task OnInitializedAsync()
    {
        var response = await Http.GetAsync($"api/cardiosessions/{Id}");
        if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            notFound = true;
        else
            session = await response.Content.ReadFromJsonAsync<CardioSession>();
    }

    private static string TypeLabel(CardioType t) => t switch
    {
        CardioType.Run  => "Course à pied",
        CardioType.Walk => "Marche",
        CardioType.Swim => "Natation",
        CardioType.Bike => "Vélo",
        _               => t.ToString()
    };

    private static string FormatDuration(TimeSpan d)
        => d.TotalHours >= 1 ? $"{(int)d.TotalHours}h{d.Minutes:D2}" : $"{d.Minutes}:{d.Seconds:D2}";

    private static string Pace(TimeSpan d, double distanceKm)
    {
        var secPerKm = d.TotalSeconds / distanceKm;
        return $"{(int)(secPerKm / 60)}:{(int)(secPerKm % 60):D2}";
    }

    private static string Capitalize(string s)
        => string.IsNullOrEmpty(s) ? s : char.ToUpper(s[0]) + s[1..];
}
