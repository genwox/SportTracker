@page "/cardiosessions/new"
@using SportTracker.Core.Enums
@using SportTracker.Core.Models
@inject HttpClient Http
@inject NavigationManager Nav

<main class="v4-cardio-form">
    <V4Header Title="Nouvelle sortie" Subtitle="Cardio" BackHref="/cardiosessions" />
    <EditForm Model="form" OnValidSubmit="HandleSubmit"><DataAnnotationsValidator />
        <V4Card><div class="v4-field"><label for="cardio-name">Nom</label><InputText id="cardio-name" class="v4-input" @bind-Value="form.Name" placeholder="Ex. Run matinal" /></div>
        <div class="v4-field"><label>Activité</label><div class="v4-cardio-types">@foreach (var type in Enum.GetValues<CardioType>()) { var current = type; <button type="button" class="@(form.Type == current ? "active" : "")" @onclick="() => form.Type = current">@TypeLabel(current)</button> }</div></div>
        <div class="v4-form-grid"><div class="v4-field"><label for="cardio-date">Date</label><InputDate id="cardio-date" class="v4-input" @bind-Value="form.Date" /></div><div class="v4-field"><label for="cardio-duration">Durée (min)</label><InputNumber id="cardio-duration" class="v4-input" @bind-Value="durationMinutes" min="1" /></div></div>
        <div class="v4-form-grid"><div class="v4-field"><label for="cardio-distance">Distance (km)</label><InputNumber id="cardio-distance" class="v4-input" @bind-Value="form.Distance" min="0" step="0.1" /></div><div class="v4-field"><label for="cardio-elevation">Dénivelé (m)</label><InputNumber id="cardio-elevation" class="v4-input" @bind-Value="form.ElevationGain" min="0" /></div></div></V4Card>
        @if (errorMessage is not null) { <V4State Title="Enregistrement impossible" Message="@errorMessage" IsError="true" /> }
        <div class="v4-form-actions"><V4Button Type="submit" Disabled="isSaving">@(isSaving ? "Enregistrement…" : "Enregistrer la sortie")</V4Button><a href="/cardiosessions">Annuler</a></div>
    </EditForm>
</main>
@code {
    private CardioSession form = new() { Date = DateTime.Today, Type = CardioType.Run }; private int durationMinutes = 30; private bool isSaving; private string? errorMessage;
    private static string TypeLabel(CardioType type) => type switch { CardioType.Run => "Course", CardioType.Walk => "Marche", CardioType.Swim => "Natation", CardioType.Bike => "Vélo", _ => type.ToString() };
    private async Task HandleSubmit() { if (durationMinutes < 1) { errorMessage = "Indique une durée d’au moins une minute."; return; } isSaving = true; errorMessage = null; form.Duration = TimeSpan.FromMinutes(durationMinutes); try { var response = await Http.PostAsJsonAsync("api/cardiosessions", form); if (response.IsSuccessStatusCode) { var created = await response.Content.ReadFromJsonAsync<CardioSession>(); Nav.NavigateTo(created is null ? "/cardiosessions" : $"/cardiosessions/{created.Id}"); return; } errorMessage = $"Le serveur a répondu {(int)response.StatusCode}. Réessaie : tes valeurs sont conservées."; } catch (Exception) { errorMessage = "Vérifie ta connexion, puis réessaie : tes valeurs sont conservées."; } finally { isSaving = false; } }
}
