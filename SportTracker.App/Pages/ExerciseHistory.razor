@page "/programs/{ProgramId:int}/sessions/{SessionId:int}/exercises/{ExerciseId:int}/history"
@using SportTracker.Core.Models
@using System.Globalization
@inject HttpClient Http

<div class="eh-page">
    <V4Header Title="@exerciseName" BackHref="@($"/programs/{ProgramId}/sessions/{SessionId}/exercises/{ExerciseId}/live")" />

    @if (loading)
    {
        <V4Loading />
    }
    else if (error)
    {
        <V4State Title="Erreur de chargement" Message="Impossible de récupérer l'historique." IsError="true" OnRetry="Reload" />
    }
    else if (!history.Any())
    {
        <V4State Title="Aucun historique" Message="Les données apparaîtront après ta première séance." />
    }
    else
    {
        <V4Card>
            <div class="eh-hero">
                <span class="eh-hero__label">Meilleur 1RM estimé</span>
                <div class="eh-hero__record">
                    <span class="eh-hero__recval">@FormatWeight(record)</span>
                    <span class="eh-hero__recunit">kg</span>
                </div>
                <span class="eh-hero__sub">Estimation d'après tes séries</span>
            </div>
        </V4Card>

        @if (points.Count >= 2)
        {
            <div class="eh-section-label">Évolution du 1RM</div>
            <V4Card>
                <div class="eh-bars">
                    @{ var maxPoint = points.Max(); }
                    @foreach (var entry in history.OrderBy(h => h.Date))
                    {
                        var e1rm = MaxOneRm(entry);
                        var isRecordBar = Math.Abs(e1rm - record) < 0.01;
                        var heightPct = maxPoint <= 0 ? 0 : Math.Max(6, e1rm / maxPoint * 100);
                        <div class="eh-bar-col">
                            <div class="eh-bar @(isRecordBar ? "eh-bar--record" : "")" style="height: @(heightPct.ToString("0.#", inv))%"></div>
                            <span class="eh-bar-label">@Capitalize(entry.Date.ToString("d MMM", frFR))</span>
                        </div>
                    }
                </div>
            </V4Card>
        }

        <div class="eh-section-label">Historique</div>
        @foreach (var entry in history.OrderByDescending(h => h.Date))
        {
            var e1rm = MaxOneRm(entry);
            var isRecord = Math.Abs(e1rm - record) < 0.01;
            <V4Card>
                <div class="eh-entry">
                    <span class="eh-entry__date">
                        @Capitalize(entry.Date.ToString("d MMMM", frFR))
                        @if (isRecord)
                        {
                            <span> · </span><span class="eh-entry__record">Record</span>
                        }
                    </span>
                    <span class="eh-entry__sets">
                        @string.Join("  ·  ", entry.Sets.OrderBy(s => s.Order).Select(s => $"{FormatWeight(s.Weight)} × {s.Repetitions}"))
                    </span>
                </div>
            </V4Card>
        }
    }

</div>

@code {
    [Parameter] public int ProgramId { get; set; }
    [Parameter] public int SessionId { get; set; }
    [Parameter] public int ExerciseId { get; set; }

    private static readonly CultureInfo frFR = CultureInfo.GetCultureInfo("fr-FR");
    private static readonly CultureInfo inv = CultureInfo.InvariantCulture;

    private bool loading = true;
    private bool error = false;
    private string exerciseName = "Exercice";
    private List<HistoryEntry> history = new();

    private double record;
    private List<double> points = new();

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try
        {
            loading = true;
            error = false;
            history.Clear();

            var programTask = Http.GetFromJsonAsync<WorkoutProgram>($"api/programs/{ProgramId}");
            var historyTask = Http.GetFromJsonAsync<List<HistoryEntry>>($"api/exercises/{ExerciseId}/history");
            await Task.WhenAll(programTask, historyTask);

            var program = programTask.Result;
            history = historyTask.Result ?? new();

            if (program == null)
            {
                error = true;
                loading = false;
                return;
            }

            var session = program.Sessions.FirstOrDefault(s => s.Id == SessionId);
            var pe = session?.Exercises.FirstOrDefault(e => e.ExerciseId == ExerciseId);
            exerciseName = pe?.Exercise?.Name ?? "Exercice";

            points = history.OrderBy(h => h.Date).Select(MaxOneRm).ToList();
            record = points.Count > 0 ? points.Max() : 0;

            loading = false;
        }
        catch
        {
            error = true;
            loading = false;
        }
    }

    private async Task Reload() => await LoadData();

    // Epley : 1RM ≈ poids × (1 + reps/30)
    private static double MaxOneRm(HistoryEntry entry)
        => entry.Sets.Count == 0 ? 0 : entry.Sets.Max(s => s.Weight * (1 + s.Repetitions / 30.0));

    private static string FormatWeight(double w)
        => w % 1 == 0 ? w.ToString("0", frFR) : w.ToString("0.#", frFR);

    private static string Capitalize(string s)
        => string.IsNullOrEmpty(s) ? s : char.ToUpper(s[0]) + s[1..];

    private class HistoryEntry
    {
        public DateTime Date { get; set; }
        public int TotalReps { get; set; }
        public double TotalVolume { get; set; }
        public List<SetEntry> Sets { get; set; } = new();
    }

    private class SetEntry
    {
        public int Order { get; set; }
        public int Repetitions { get; set; }
        public double Weight { get; set; }
    }
}
