@page "/programs/{ProgramId:int}"
@using System.Net
@using SportTracker.Core.Models
@inject HttpClient Http

<div class="v4-program-detail">
    <V4Header Title="@(program?.Name ?? "Carnet")" Subtitle="Tous les carnets" BackHref="/programs" />
    @if (isLoading) { <V4Loading /> }
    else if (notFound) { <V4State Title="Carnet introuvable" Message="Il a peut-être été supprimé ou n’est plus accessible."><V4Button Href="/programs" Secondary="true">Revenir aux carnets</V4Button></V4State> }
    else if (errorMessage is not null) { <V4State Title="Impossible de charger ce carnet" Message="@errorMessage" IsError="true" OnRetry="LoadProgramAsync" /> }
    else if (program is not null)
    {
        <V4Card><div class="v4-program-objective"><p>Ton objectif</p><h2>@(string.IsNullOrWhiteSpace(program.Objective) ? "À ton rythme" : program.Objective)</h2><div class="v4-program-stats"><div><strong>@program.Sessions.Count</strong><small>séances</small></div><div><strong>@program.Sessions.Sum(session => session.Exercises.Count)</strong><small>exercices</small></div></div></div></V4Card>
        @if (!program.Sessions.Any())
        {
            <V4State Title="Aucune séance" Message="Ajoute une séance pour commencer à utiliser ce carnet."><V4Button Href="@($"/programs/{ProgramId}/sessions/new")">Ajouter une séance</V4Button></V4State>
        }
        else
        {
            <section class="v4-program-session-list" aria-labelledby="program-sessions-title"><div class="v4-program-section-heading"><div><h2 id="program-sessions-title">Choisir une séance</h2><p>Sélectionne celle que tu veux préparer.</p></div><span>@program.Sessions.Count</span></div>
            @foreach (var session in program.Sessions.OrderBy(session => session.Order)) { var exerciseCount = session.Exercises?.Count ?? 0; <a class="v4-program-session" href="/programs/@ProgramId/sessions/@session.Id"><span class="v4-program-session__number">@(session.Order + 1)</span><span><strong>@session.Name</strong><small>@exerciseCount exercice@(exerciseCount > 1 ? "s" : "")</small></span><span class="v4-program-session__chevron" aria-hidden="true">›</span></a> }
            </section>
            <V4Button Href="@($"/programs/{ProgramId}/sessions/new")" Secondary="true">+ Ajouter une séance</V4Button>
        }
    }
</div>
@code {
    [Parameter] public int ProgramId { get; set; }
    private WorkoutProgram? program; private bool isLoading = true; private bool notFound; private string? errorMessage;
    protected override Task OnParametersSetAsync() => LoadProgramAsync();
    private async Task LoadProgramAsync()
    {
        isLoading = true; notFound = false; errorMessage = null;
        try { using var response = await Http.GetAsync($"api/programs/{ProgramId}"); if (response.StatusCode == HttpStatusCode.NotFound) { notFound = true; return; } if (!response.IsSuccessStatusCode) { errorMessage = $"Le serveur a répondu {(int)response.StatusCode}."; return; } program = await response.Content.ReadFromJsonAsync<WorkoutProgram>(); if (program is null) errorMessage = "Le carnet n’a pas pu être lu."; }
        catch (Exception) { errorMessage = "Vérifie ta connexion, puis réessaie."; }
        finally { isLoading = false; }
    }
}
