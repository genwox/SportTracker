@page "/progress"
@using SportTracker.Core.Models
@using SportTracker.Core.Enums
@using SportTracker.App.Services
@using System.Globalization
@inject HttpClient Http
@inject WeeklyGoalService WeeklyGoal

<div class="progress-page">
    <V4Header Title="Tes progrès" Subtitle="@weekSubtitle" />

    @if (loading)
    {
        <V4Loading />
    }
    else if (errorMessage is not null)
    {
        <V4State Title="Impossible de charger tes progrès" Message="@errorMessage" IsError="true" OnRetry="LoadAsync" />
    }
    else
    {
        <V4Card>
            <div class="pr-minutes">
                <span class="pr-minutes__label">Minutes cette semaine</span>
                <span class="pr-minutes__val">@weeklyMinutes min</span>
                @if (weeklyMinutesDelta != 0)
                {
                    <span class="pr-minutes__trend">@(weeklyMinutesDelta > 0 ? "+" : "") @weeklyMinutesDelta min par rapport à la semaine dernière</span>
                }
            </div>
        </V4Card>

        <div class="pr-pair">
            <V4Card>
                <div class="pr-stat">
                    <span class="pr-stat__val">@streak</span>
                    <span class="pr-stat__label">jour@(streak > 1 ? "s" : "")</span>
                    <span class="pr-stat__sub">série en cours</span>
                </div>
            </V4Card>
            <V4Card>
                <div class="pr-stat">
                    <span class="pr-stat__val">@weekSessions</span>
                    <span class="pr-stat__label">séances cette semaine</span>
                    @if (weekSessions >= weeklyGoal)
                    {
                        <span class="pr-stat__badge">Objectif atteint</span>
                    }
                </div>
            </V4Card>
        </div>

        <div class="pr-section-label">Répartition musculaire · 30 jours</div>
        <V4Card>
            @if (muscleDistribution.Count == 0)
            {
                <p class="pr-empty">Aucune série musculaire sur les 30 derniers jours.</p>
            }
            else
            {
                <div class="pr-muscle-strip" role="img" aria-label="Répartition des séries par groupe musculaire">
                    @foreach (var group in muscleDistribution)
                    {
                        <div class="pr-muscle-segment" style="width: @((100d * group.Count / muscleDistribution.Sum(item => item.Count)).ToString("0.##", CultureInfo.InvariantCulture))%; background: @group.Color" title="@($"{group.Label} : {group.Count} séries")"></div>
                    }
                </div>
                <div class="pr-muscle-legend">
                    @foreach (var group in muscleDistribution)
                    {
                        <span><i style="background: @group.Color"></i>@group.Label · @group.Count</span>
                    }
                </div>
            }
        </V4Card>

        <div class="pr-section-label">Séries par groupe · cette semaine</div>
        <V4Card>
            @if (weeklyMuscleSets.Count == 0)
            {
                <p class="pr-empty">Aucune série enregistrée cette semaine.</p>
            }
            else
            {
                <div class="pr-group-bars">
                    @{ var maxSets = weeklyMuscleSets.Max(group => group.Count); }
                    @foreach (var group in weeklyMuscleSets)
                    {
                        <div class="pr-group-bar" title="@($"{group.Label} : {group.Count} séries")">
                            <strong>@group.Count</strong>
                            <div class="pr-group-bar__track"><div class="pr-group-bar__fill" style="height: @((100d * group.Count / maxSets).ToString("0.#", CultureInfo.InvariantCulture))%; background: @group.Color"></div></div>
                            <span>@group.Label</span>
                        </div>
                    }
                </div>
            }
        </V4Card>

        <div class="pr-section-label">Séances par jour</div>
        <V4Card>
            <div class="pr-bars">
                @{
                    var maxVal = volumeData.Max(v => v.count) is int m && m > 0 ? m : 1;
                }
                @foreach (var day in volumeData)
                {
                    var heightPct = day.count == 0 ? 0 : Math.Max(10, (double)day.count / maxVal * 100);
                    <div class="pr-bar-col">
                        <div class="pr-bar-slot">
                            @if (day.count > 0)
                            {
                                <div class="pr-bar-fill @(day.isToday ? "pr-bar-fill--active" : "")" style="height: @(heightPct)%"></div>
                            }
                        </div>
                        <span class="pr-bar-label @(day.isToday ? "pr-bar-label--active" : "")">@day.label</span>
                    </div>
                }
            </div>
        </V4Card>

        <V4Card>
            <div class="pr-footer">
                <strong>Continue sur ta lancée</strong>
                <span>Tes séances alimentent ce bilan.</span>
            </div>
        </V4Card>
    }
</div>

@code {
    private static readonly CultureInfo frFR = CultureInfo.GetCultureInfo("fr-FR");

    private bool loading = true;
    private string? errorMessage;
    private string weekSubtitle = "";
    private int weeklyMinutes;
    private int weeklyMinutesDelta;
    private int streak;
    private int weekSessions;
    private int weeklyGoal = WeeklyGoalService.DefaultGoal;
    private List<(string label, int count, bool isToday)> volumeData = [];
    private List<MuscleStat> muscleDistribution = [];
    private List<MuscleStat> weeklyMuscleSets = [];
    private sealed record MuscleStat(string Label, int Count, string Color);
    private static readonly (MuscleGroup Group, string Label, string Color)[] muscleGroups =
    [
        (MuscleGroup.Chest, "Pecs", "#17374a"), (MuscleGroup.Back, "Dos", "#d4f53c"),
        (MuscleGroup.Legs, "Jambes", "#24495b"), (MuscleGroup.Shoulders, "Épaules", "#527181"),
        (MuscleGroup.Biceps, "Biceps", "#75a0a5"), (MuscleGroup.Triceps, "Triceps", "#92b8b6"),
        (MuscleGroup.Glutes, "Fessiers", "#a8c9c3"), (MuscleGroup.Abs, "Abdos", "#bedbd3"),
        (MuscleGroup.FullBody, "Corps entier", "#d7eae5")
    ];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            loading = true;
            errorMessage = null;

            var workoutsTask = Http.GetFromJsonAsync<List<WorkoutSession>>("api/workoutsessions");
            var cardioTask   = Http.GetFromJsonAsync<List<CardioSession>>("api/cardiosessions");
            var goalTask     = WeeklyGoal.GetGoalAsync();
            await Task.WhenAll(workoutsTask, cardioTask, goalTask);

            var workouts = workoutsTask.Result ?? [];
            var cardio   = cardioTask.Result ?? [];
            weeklyGoal   = goalTask.Result;

            var today   = DateTime.Today;
            var monday  = today.AddDays(-(((int)today.DayOfWeek + 6) % 7));
            var lastMon = monday.AddDays(-7);

            weekSubtitle = $"Semaine du {monday.ToString("d MMMM", frFR)}";

            var allDates = workouts.Select(s => s.Date.Date)
                .Concat(cardio.Select(s => s.Date.Date))
                .ToHashSet();

            var thisWeekWorkouts = workouts.Where(s => s.Date.Date >= monday);
            var thisWeekCardio   = cardio.Where(s => s.Date.Date >= monday);
            weeklyMinutes = (int)(thisWeekWorkouts.Sum(s => s.Duration.TotalMinutes)
                                + thisWeekCardio.Sum(s => s.Duration.TotalMinutes));

            var lastWeekMin = (int)(workouts.Where(s => s.Date.Date >= lastMon && s.Date.Date < monday).Sum(s => s.Duration.TotalMinutes)
                                  + cardio.Where(s => s.Date.Date >= lastMon && s.Date.Date < monday).Sum(s => s.Duration.TotalMinutes));
            weeklyMinutesDelta = weeklyMinutes - lastWeekMin;

            weekSessions = thisWeekWorkouts.Count() + thisWeekCardio.Count();

            streak = 0;
            var check = today;
            while (allDates.Contains(check))
            {
                streak++;
                check = check.AddDays(-1);
            }

            volumeData = Enumerable.Range(0, 7).Select(i =>
            {
                var day   = monday.AddDays(i);
                var count = workouts.Count(s => s.Date.Date == day) + cardio.Count(s => s.Date.Date == day);
                var labels = new[] { "L", "M", "M", "J", "V", "S", "D" };
                return (labels[i], count, day == today);
            }).ToList();

            muscleDistribution = CountMuscleSets(workouts.Where(s => s.Date.Date >= today.AddDays(-29)));
            weeklyMuscleSets = CountMuscleSets(thisWeekWorkouts);

            loading = false;
        }
        catch
        {
            errorMessage = "Impossible de récupérer tes séances.";
            loading = false;
        }
    }

    private static List<MuscleStat> CountMuscleSets(IEnumerable<WorkoutSession> sessions)
    {
        var counts = sessions.SelectMany(session => session.WorkoutExercises ?? [])
            .Where(workoutExercise => workoutExercise.Exercise is not null)
            .SelectMany(workoutExercise => workoutExercise.Exercise!.MuscleGroups.Distinct()
                .Select(group => (Group: group, Count: workoutExercise.ExerciseSets?.Count ?? 0)))
            .GroupBy(item => item.Group)
            .ToDictionary(group => group.Key, group => group.Sum(item => item.Count));

        return muscleGroups.Where(group => counts.GetValueOrDefault(group.Group) > 0)
            .Select(group => new MuscleStat(group.Label, counts[group.Group], group.Color)).ToList();
    }
}
