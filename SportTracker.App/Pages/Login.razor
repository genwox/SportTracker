@page "/login"
@layout EmptyLayout
@attribute [AllowAnonymous]
@inject AuthService Auth
@inject NavigationManager Nav

<div class="auth-page">
    <header class="auth-heading">
        <h1>SportTracker</h1>
        <p>Ton entraînement, à ton rythme.</p>
    </header>

    <EditForm Model="model" OnValidSubmit="HandleLogin" class="auth-card">
        <DataAnnotationsValidator />

        <section class="auth-intro">
            <img src="assets/v4/023-weight lifting.png" alt="" width="86" height="86" />
            <h2>Heureux de te retrouver.</h2>
            <p>Connecte-toi pour retrouver tes séances et tes progrès.</p>
        </section>

        @if (error is not null)
        {
            <div class="auth-error" role="alert">@error</div>
        }

        <div class="field-group">
            <label class="field-label" for="login-email">Adresse e-mail</label>
            <InputText @bind-Value="model.Email" type="email" autocomplete="username"
                       id="login-email" class="field-input" placeholder="toi@exemple.fr" />
            <ValidationMessage For="() => model.Email" />
        </div>

        <div class="field-group">
            <label class="field-label" for="login-password">Mot de passe</label>
            <InputText @bind-Value="model.Password" type="password" autocomplete="current-password"
                       id="login-password" class="field-input" placeholder="••••••••" />
            <ValidationMessage For="() => model.Password" />
        </div>

        <div class="form-actions">
            <button type="submit" class="auth-primary" disabled="@busy">
                @(busy ? "Connexion…" : "Se connecter")
            </button>
        </div>

        <p class="auth-switch">Pas encore de compte ?</p>
        <a class="auth-secondary" href="/register">Créer un compte</a>
    </EditForm>
</div>

@code {
    private readonly Credentials model = new();
    private bool busy;
    private string? error;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private async Task HandleLogin()
    {
        busy = true;
        error = null;

        error = await Auth.LoginAsync(model.Email, model.Password);

        busy = false;

        if (error is null)
            Nav.NavigateTo(string.IsNullOrEmpty(ReturnUrl) ? "/" : ReturnUrl);
    }

    private sealed class Credentials
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Email requis")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Email invalide")]
        public string Email { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Mot de passe requis")]
        public string Password { get; set; } = "";
    }
}
