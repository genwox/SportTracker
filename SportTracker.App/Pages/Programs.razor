@page "/programs"
@using SportTracker.Core.Models
@inject HttpClient Http

<main class="v4-programs">
    <V4Header Title="Carnets" Subtitle="Tes programmes d’entraînement" />
    <V4ActivityTabs />

    @if (isLoading) { <V4Loading /> }
    else if (errorMessage is not null) { <V4State Title="Impossible de charger les carnets" Message="@errorMessage" IsError="true" OnRetry="LoadProgramsAsync" /> }
    else if (programs is not null && !programs.Any())
    {
        <V4State Title="Premier carnet" Message="Organise tes séances pour les retrouver facilement."><V4Button Href="/programs/new">Créer mon carnet</V4Button></V4State>
    }
    else if (programs is not null)
    {
        <V4Button Href="/programs/new">+ Nouveau carnet</V4Button>
        <section class="v4-program-list" aria-label="Mes carnets">
            @foreach (var program in programs)
            {
                <a class="v4-program-row" href="/programs/@program.Id">
                    <span class="v4-program-row__swatch" style="background-color:@program.ColorHex" aria-hidden="true"></span>
                    <span class="v4-program-row__content"><strong>@program.Name</strong><small>@ProgramMeta(program)</small></span>
                    <span class="v4-program-row__chevron" aria-hidden="true">›</span>
                </a>
            }
        </section>
    }
</main>

@code {
    private List<WorkoutProgram>? programs;
    private bool isLoading = true;
    private string? errorMessage;
    protected override Task OnInitializedAsync() => LoadProgramsAsync();
    private async Task LoadProgramsAsync()
    {
        isLoading = true; errorMessage = null;
        try { programs = await Http.GetFromJsonAsync<List<WorkoutProgram>>("api/programs") ?? new(); }
        catch (Exception) { errorMessage = "Vérifie ta connexion, puis réessaie."; }
        finally { isLoading = false; }
    }
    private static string ProgramMeta(WorkoutProgram program)
        => string.IsNullOrWhiteSpace(program.Objective) ? "Carnet d’entraînement" : program.Objective;
}
