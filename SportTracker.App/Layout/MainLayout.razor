@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject SportTracker.App.Services.LiveDraftService Drafts
@inject IJSRuntime JS

<AuthorizeView>
    <Authorized>
        <div class="app-shell">
            <a class="skip-link" href="#main-content">Aller au contenu</a>
            <main id="main-content" class="app-main" tabindex="-1">
                @Body
            </main>
            <NavMenu />
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
    <Authorizing>
        <div class="auth-loading">
            <V4Loading />
        </div>
    </Authorizing>
</AuthorizeView>

@code {
    private DotNetObjectReference<MainLayout>? networkRef;
    private int watcherId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        networkRef = DotNetObjectReference.Create(this);
        watcherId = await JS.InvokeAsync<int>("liveDrafts.watchOnline", networkRef);
        try { await Drafts.SyncPendingAsync(); }
        catch (Exception) { /* La reprise sera retentée à la prochaine reconnexion. */ }
    }

    [JSInvokable]
    public async Task OnNetworkChanged(bool online)
    {
        if (!online) return;
        try { await Drafts.SyncPendingAsync(); }
        catch (Exception) { /* Brouillon conservé dans IndexedDB. */ }
    }

    public async ValueTask DisposeAsync()
    {
        if (watcherId != 0)
        {
            try { await JS.InvokeVoidAsync("liveDrafts.unwatchOnline", watcherId); }
            catch (JSDisconnectedException) { }
        }
        networkRef?.Dispose();
    }
}
