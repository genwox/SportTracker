@inherits LayoutComponentBase

<AuthorizeView>
    <Authorized>
        <div class="app-shell">
            <a class="skip-link" href="#main-content">Aller au contenu</a>
            <main id="main-content" class="app-main" tabindex="-1">
                @Body
            </main>
            <NavMenu />
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
    <Authorizing>
        <div class="auth-loading">
            <V4Loading />
        </div>
    </Authorizing>
</AuthorizeView>
